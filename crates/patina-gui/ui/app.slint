// PatinaPlayer desktop UI. Layout follows the design mockup: sidebar,
// header with back/forward and search, the open view, an optional queue
// panel, and the bottom bar. All state and every action lives in Rust
// (patina-core's Browser); this file only draws and forwards input.

import { ListView, ScrollView } from "std-widgets.slint";

import "fonts/Inter-Regular.otf";
import "fonts/Inter-Medium.otf";
import "fonts/Inter-SemiBold.otf";
import "fonts/Inter-Bold.otf";
import "fonts/NotoSerif-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";

// ----- Palette (Runout) -----

export global P {
    out property <color> bg: #0e1917;
    out property <color> surface: #132220;
    out property <color> raised: #172a27;
    out property <color> border: #2a3d39;
    out property <color> text: #e6ece9;
    out property <color> muted: #8fa39d;
    out property <color> verdigris: #5fb8a5;
    out property <color> verdigris-dim: #2f5f55;
    out property <color> copper: #d4884a;
    out property <color> copper-dim: #5a3a22;
    out property <color> wave: #4a5f5a;
    out property <color> on-accent: #0b1513;
    out property <color> playing-bg: #5fb8a51f;
    out property <string> serif: "Noto Serif";
    out property <string> mono: "JetBrains Mono";
}

// ----- Data from Rust -----

export struct SideItem {
    // 0 section, 1 source, 2 label, 3 gap
    kind: int,
    label: string,
    count: string,
    icon: string,
    active: bool,
    // sources: 0 watching, 1 scanning, 2 missing, 3 idle
    dot: int,
}

export struct Row {
    // 0 track, 1 album, 2 artist, 3 folder, 4 genre, 5 playlist, 6 station,
    // 7 podcast, 8 episode, 9 header, 10 info, 11 missing file, 12 setting
    kind: int,
    num: string,
    title: string,
    sub: string,
    meta: string,
    right: string,
    playing: bool,
    dim: bool,
    warn: bool,
    selectable: bool,
    art: image,
    has-art: bool,
    downloaded: bool,
    // Settings rows (kind 12): 1 toggle, 2 choice, 3 number, 4 text,
    // 5 library folder, 6 add folder, 7 read-only.
    ctl: int,
    on: bool,
}

export struct QueueRow {
    title: string,
    sub: string,
    playing: bool,
    failed: bool,
    art: image,
    has-art: bool,
}

export struct Hero {
    show: bool,
    kicker: string,
    title: string,
    sub: string,
    meta: string,
    art: image,
    has-art: bool,
}

// ----- Small parts -----

// Stroke icon from SVG path data on a 24-unit grid.
component Icon inherits Path {
    in property <string> d;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    stroke: P.muted;
    stroke-width: 1.8px;
    fill: transparent;
}

component FilledIcon inherits Path {
    in property <string> d;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    fill: P.muted;
    stroke-width: 0px;
}

