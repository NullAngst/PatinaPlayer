component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> filled: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 18px;
    in property <string> tip;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 6px * P.round;
    border-width: 1px;
    border-color: ta.has-hover && enabled ? P.border : transparent;
    accessible-role: button;
    accessible-label: tip;
    accessible-action-default => { if enabled { clicked(); } }
    if !filled: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        d: icon;
        size: icon-size;
        stroke: !enabled ? P.border : (active ? P.verdigris : (ta.has-hover ? P.text : P.muted));
    }
    if filled: FilledIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        d: icon;
        size: icon-size;
        fill: !enabled ? P.border : (active ? P.verdigris : (ta.has-hover ? P.text : P.muted));
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
}

// A row of buttons that scrolls sideways when it doesn't fit, instead of
// making everything around it wider. A row that won't fit used to push
// the whole view (header and all) past the right edge of a phone.
component HScroll inherits Flickable {
    in property <length> spacing: 8px;
    in property <LayoutAlignment> align: start;
    min-width: 0px;
    preferred-width: row.preferred-width;
    height: row.preferred-height;
    content-width: max(self.width, row.preferred-width);
    content-height: self.height;
    row := HorizontalLayout {
        width: root.content-width;
        height: root.height;
        spacing: root.spacing;
        alignment: root.align;
        @children
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <length> h: 32px;
    callback clicked;
    // Narrow windows: the icon alone, for chips that have one.
    in property <bool> icon-only: false;
    // What a right-click or long press shows when the label is cut short
    // (or hidden, on an icon-only chip). The label without its "▾".
    in property <string> peek: text;
    height: h;
    border-radius: 6px * P.round;
    border-width: 1px;
    // Kawaii buttons sit on a pressed-in edge.
    drop-shadow-offset-y: primary && P.kawaii ? 3px : 0px;
    drop-shadow-color: primary && P.kawaii ? P.accent-edge : transparent;
    border-color: primary ? P.verdigris : (danger ? P.copper-dim : (active ? P.verdigris-dim : P.border));
    background: primary ? (ta.has-hover ? P.accent-hover : P.verdigris) : (ta.has-hover ? P.chip-hover : P.raised);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        if icon != "": Rectangle {
            width: 15px;
            Icon {
            y: (parent.height - self.height) / 2;
            d: root.icon;
            size: 15px;
            stroke: primary ? P.on-accent : (danger ? P.copper : (active ? P.verdigris : P.text));
            }
        }
        if !(root.icon-only && root.icon != ""): Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            font-size: 12.5px;
            font-weight: primary || P.kawaii ? 700 : 400;
            color: primary ? P.on-accent : (danger ? P.copper : (active ? P.accent-text : P.text));
        }
    }
    // The label at its full width, unseen, to tell whether it fits.
    measure := Text {
        width: 0px;
        height: 0px;
        visible: false;
        text: root.text;
        font-size: 12.5px;
        font-weight: primary || P.kawaii ? 700 : 400;
    }
    ta := PeekArea {
        mouse-cursor: pointer;
        full: root.peek;
        cut: (root.icon-only && root.icon != "")
            || measure.preferred-width > root.width - 24px - (root.icon != "" ? 22px : 0px) + 0.5px;
        tapped => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg: P.muted;
    height: 20px;
    width: t.preferred-width + 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: P.border;
    t := Text {
        text: root.text;
        font-family: P.mono;
        font-size: 11px;
        color: root.fg;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Cover inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <length> radius: 6px;
    border-radius: radius * P.round;
    background: P.raised;
    border-width: has-art ? 0px : 1px;
    border-color: P.border;
    clip: true;
    if has-art: Image {
        source: art;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if !has-art: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        d: Icons.disc;
        size: min(parent.width, parent.height) * 0.35;
        stroke: P.wave;
        stroke-width: 1.2px;
    }
}

// Seek or volume bar. While dragging, it shows the drag position and only
// reports on release when `live` is off, so a seek happens once.
component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <bool> live: false;
    in property <color> fill: P.verdigris;
    in property <length> knob: 14px;
    in property <string> label;
    // Show the knob all the time, not just on hover (touch screens have
    // no hover).
    in property <bool> show-knob: false;
    // The mouse wheel moves it (live bars only).
    in property <bool> wheel: true;
    callback changed(float);
    property <float> drag: 0;
    property <bool> dragging: ta.pressed && enabled;
    property <float> shown: dragging ? drag : value;
    height: 18px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: round(value * 100) + "%";
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: enabled ? P.wave : P.border;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.shown, 0, 1);
            border-radius: 3px;
            background: root.enabled ? root.fill : transparent;
        }
    }
    // Kawaii: a heart that's always there.
    if enabled && P.kawaii: FilledIcon {
        x: parent.width * clamp(root.shown, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        d: Icons.heart;
        size: root.knob + 6px;
        fill: (ta.has-hover || root.dragging) ? P.accent-text : P.verdigris;
    }
    if enabled && !P.kawaii && (ta.has-hover || dragging || show-knob): Rectangle {
        x: parent.width * clamp(root.shown, 0, 1) - root.knob / 2;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: P.text;
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        pointer-event(e) => {
            if !enabled { return; }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag = clamp(self.mouse-x / self.width, 0, 1);
                if root.live { root.changed(root.drag); }
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && !root.live {
                root.changed(root.drag);
            }
        }
        moved => {
            if !enabled { return; }
            root.drag = clamp(self.mouse-x / self.width, 0, 1);
            if root.live { root.changed(root.drag); }
        }
        scroll-event(e) => {
            if !enabled || !root.live || !root.wheel { return reject; }
            root.changed(clamp(root.value + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
    }
}

// The volume as a tall slider, for the popup on a touch screen: drag up
// or down anywhere on it, or tap a spot. Big enough for a thumb.
component VBar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <color> fill: P.verdigris;
    in property <string> label;
    callback changed(float);
    property <float> drag: 0;
    property <bool> dragging: ta.pressed && enabled;
    property <float> shown: clamp(dragging ? drag : value, 0, 1);
    // Room top and bottom so the knob stays on the slider at the ends.
    property <length> pad: 14px;
    property <length> run: self.height - 2 * self.pad;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: round(value * 100) + "%";
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.pad;
        width: 10px;
        height: root.run;
        border-radius: 5px;
        background: root.enabled ? P.wave : P.border;
        Rectangle {
            y: parent.height * (1 - root.shown);
            height: parent.height - self.y;
            border-radius: 5px;
            background: root.enabled ? root.fill : transparent;
        }
    }
    if root.enabled: Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.pad + root.run * (1 - root.shown) - self.height / 2;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: P.text;
        border-width: 2px;
        border-color: P.raised;
    }
    ta := TouchArea {
        function at(my: length) -> float {
            return clamp(1 - (my - root.pad) / root.run, 0, 1);
        }
        pointer-event(e) => {
            if !root.enabled { return; }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag = self.at(self.mouse-y);
                root.changed(root.drag);
            }
        }
        moved => {
            if !root.enabled { return; }
            root.drag = self.at(self.mouse-y);
            root.changed(root.drag);
        }
    }
}

// A one-line text input that scrolls sideways with the cursor, the way
// std-widgets' LineEdit does: a plain TextInput just runs off its edge,
// so the end of a long URL could be neither seen nor reached.
component ScrollingInput inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <length> font-size <=> ti.font-size;
    in property <InputType> input-type <=> ti.input-type;
    in property <bool> enabled <=> ti.enabled;
    out property <bool> has-focus: ti.has-focus;
    callback accepted;
    callback edited;
    callback key-pressed(KeyEvent) -> EventResult;
    public function select-all() { ti.select-all(); }
    public function set-selection-offsets(anchor: int, cursor: int) {
        ti.set-selection-offsets(anchor, cursor);
    }
    clip: true;
    forward-focus: ti;
    ti := TextInput {
        property <length> scroll-x;
        x: min(0px, max(root.width - self.width - self.text-cursor-width, self.scroll-x));
        width: max(root.width - self.text-cursor-width, self.preferred-width);
        height: root.height;
        color: P.text;
        selection-background-color: P.verdigris-dim;
        vertical-alignment: center;
        single-line: true;
        cursor-position-changed(pos) => {
            if pos.x + self.scroll-x < 0px {
                self.scroll-x = -pos.x;
            } else if pos.x + self.scroll-x > root.width - self.text-cursor-width {
                self.scroll-x = root.width - pos.x - self.text-cursor-width;
            }
        }
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        key-pressed(e) => { root.key-pressed(e) }
    }
}

component Field inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> autofocus: false;
    // Passwords: dots on screen.
    in property <bool> secret: false;
    callback accepted;
    callback edited(string);
    public function focus-field() { ti.focus(); }
    // Cursor at the end, so a prefilled "~/" or value is added to, not
    // typed in front of.
    init => {
        if autofocus {
            ti.focus();
            ti.set-selection-offsets(ti.text.character-count * 4, ti.text.character-count * 4);
        }
    }
    height: 58px;
    VerticalLayout {
        spacing: 6px;
        Text { text: root.label; font-size: 12px; color: P.muted; }
        Rectangle {
            height: 36px;
            border-radius: 6px * P.round;
            border-width: 1px;
            border-color: ti.has-focus ? P.verdigris-dim : P.border;
            background: P.bg;
            // The text scrolls sideways inside this to keep the cursor in
            // view, so a long URL can be typed and read to its end.
            ti := ScrollingInput {
                    x: 10px;
                    width: parent.width - 20px;
                    text <=> root.text;
                    font-size: 13px;
                    input-type: root.secret ? InputType.password : InputType.text;
                    accepted => { root.accepted(); }
                    edited => { root.edited(self.text); }
            }
            if ti.text == "": Text {
                x: 10px;
                text: root.placeholder;
                color: P.wave;
                vertical-alignment: center;
                font-size: 13px;
            }
        }
    }
}

// ----- Rows -----

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? P.verdigris : P.raised;
    border-width: 1px;
    border-color: on ? P.verdigris : P.border;
    accessible-role: switch;
    accessible-checked: on;
    accessible-action-default => { toggled(); }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        y: 2px;
        x: root.on ? root.width - self.width - 3px : 3px;
        background: root.on ? P.on-accent : P.muted;
        animate x { duration: 120ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component ListRow inherits Rectangle {
    // Rows are placed by the list, so they take its width.
    in property <Row> item;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> album-tracks;
    // The open list is Hearted songs: removing a song unhearts it.
    in property <bool> hearted;
    callback select;
    callback activate;
    callback act(string);
    // Held long enough to open the menu; the release then doesn't open
    // or play the row too.
    property <bool> long-fired;
    property <length> press-x;
    property <length> press-y;
    // A narrow list drops the third column and tightens the rest.
    property <bool> slim: self.width < 560px;
    // The title doesn't fit: its menu opens with the whole of it, and a
    // row with no menu shows it in a bubble.
    property <bool> title-cut;
    property <string> title-full: item.kind == 11 ? "missing: " + item.title : item.title;
    // Whether the menu below has anything in it. A settings row, a header
    // or a button in the list has nothing, and a long press or right-click
    // on one used to open an empty box. Keep in step with the Menu.
    // Settings rows never count a cut title: a reused row can still hold
    // one from the song it showed before.
    property <bool> has-menu: (root.title-cut && item.kind != 12)
        || item.kind <= 8
        || (item.kind == 11 && !root.album-tracks)
        || item.kind == 13
        || item.kind == 14
        || item.kind == 16
        || item.can-mix
        || item.rating >= 0
        || item.fav >= 0
        || item.can-pin;
    height: item.kind == 9 ? 34px : (item.kind == 12 ? 54px : 40px);
    background: item.playing ? P.playing-bg : (selected ? (focused ? P.raised : P.sel-idle) : (ta.has-hover && item.selectable ? P.hover : transparent));
    border-radius: 6px * P.round;
    border-width: item.playing && P.kawaii ? 2px : 0px;
    border-color: P.verdigris;

    // Header rows (search groups).
    if item.kind == 9: Text {
        x: 12px;
        y: parent.height - self.height - 4px;
        text: item.title;
        color: P.accent-text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.9px;
    }

    if item.kind != 9 && item.kind != 12: HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 12px;
        // Number, play marker or kind glyph, with a dot for pinned.
        Rectangle {
            width: 32px;
            if item.pinned && !item.playing: Text {
                x: 0px;
                height: parent.height;
                text: "↓";
                vertical-alignment: center;
                font-size: 12px;
                font-weight: 700;
                color: P.verdigris;
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: item.playing ? (P.kawaii ? "♪" : "▶") : (item.kind == 4 && item.on ? "✓" : (item.kind == 16 ? "∞" : (item.kind == 5 && item.fixed ? "♥" : item.num)));
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: P.mono;
                font-size: 12px;
                font-weight: P.kawaii ? 700 : 400;
                color: item.playing || (item.kind == 4 && item.on) || (item.kind == 5 && item.fixed) ? P.accent-text : (P.kawaii ? P.muted : P.wave);
            }
        }
        if item.kind == 1 || item.kind == 3: Rectangle {
            width: 30px;
            Cover {
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 30px;
                radius: 4px;
                art: item.art;
                has-art: item.has-art;
            }
        }
        Text {
            // Settings rows give the value most of the room.
            horizontal-stretch: item.kind == 10 ? 1.2 : 4;
            preferred-width: 0px;
            min-width: 60px;
            text: root.title-full;
            overflow: elide;
            vertical-alignment: center;
            font-size: 13px;
            init => { root.title-cut = self.preferred-width > self.width + 0.5px; }
            changed width => { root.title-cut = self.preferred-width > self.width + 0.5px; }
            changed text => { root.title-cut = self.preferred-width > self.width + 0.5px; }
            font-weight: item.playing || item.kind == 15 ? (P.kawaii ? 800 : 600) : 400;
            color: item.warn ? P.copper : (item.playing || item.kind == 15 ? P.accent-text : (item.off ? P.wave : (item.dim ? P.muted : P.text)));
        }
        if item.stars != "": Text {
            text: item.stars;
            vertical-alignment: center;
            font-size: 11px;
            color: P.copper;
        }
        if item.sub != "" || item.kind <= 2: Text {
            horizontal-stretch: item.kind == 10 ? 5 : 2.5;
            preferred-width: 0px;
            min-width: 40px;
            text: item.sub;
            overflow: elide;
            vertical-alignment: center;
            font-size: 12.5px;
            color: item.warn ? P.copper : (item.playing ? P.accent-text : (item.off ? P.wave : P.muted));
        }
        if (item.meta != "" || item.kind <= 2) && (!slim || item.kind == 10): Text {
            horizontal-stretch: 2.5;
            preferred-width: 0px;
            min-width: 60px;
            text: item.meta;
            overflow: elide;
            vertical-alignment: center;
            font-size: 12.5px;
            color: item.warn ? P.copper : (item.playing ? P.accent-text : (item.off ? P.wave : P.muted));
        }
        Text {
            min-width: root.width < 400px ? 44px : 64px;
            text: item.right;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: P.mono;
            font-size: 11.5px;
            color: P.muted;
        }
    }

    cm := ContextMenuArea {
        enabled: item.selectable && root.has-menu;
        Menu {
            // The whole title, when the row cuts it short.
            if root.title-cut && item.kind != 12: MenuItem { title: root.title-full; enabled: false; }
            if root.title-cut && item.kind != 12: MenuSeparator {}
            // Things that play.
            if item.kind <= 8 || item.kind == 13 || item.kind == 16: MenuItem {
                title: item.kind == 8 ? "Play (resume)" : "Play";
                activated => { root.act("play"); }
            }
            if item.can-mix: MenuItem {
                title: item.kind == 0 ? "Track mix" : (item.kind == 4 ? "Genre mix" : "Artist mix");
                activated => { root.act("mix"); }
            }
            if item.kind == 4: MenuItem {
                title: item.on ? "Unmark for a mix" : "Mark for a mix";
                activated => { root.act("mark"); }
            }
            if item.kind <= 8 || item.kind == 13: MenuItem {
                title: "Play next";
                activated => { root.act("next"); }
            }
            if item.kind <= 8 || item.kind == 13: MenuItem {
                title: "Add to queue";
                activated => { root.act("queue"); }
            }
            if item.kind <= 5: MenuItem {
                title: "Add to playlist…";
                activated => { root.act("playlist"); }
            }
            // A song: its album, or its artist.
            if item.kind == 0: MenuSeparator {}
            if item.kind == 0: MenuItem { title: "Go to album"; activated => { root.act("go-album"); } }
            if item.kind == 0: MenuItem { title: "Go to artist"; activated => { root.act("go-artist"); } }
            // Ratings and favorites.
            if item.rating >= 0 || item.fav >= 0: MenuSeparator {}
            if item.rating >= 0: Menu {
                title: item.rating > 0 ? "Rated " + item.stars : "Rate";
                MenuItem { title: "★★★★★"; activated => { root.act("rate-5"); } }
                MenuItem { title: "★★★★"; activated => { root.act("rate-4"); } }
                MenuItem { title: "★★★"; activated => { root.act("rate-3"); } }
                MenuItem { title: "★★"; activated => { root.act("rate-2"); } }
                MenuItem { title: "★"; activated => { root.act("rate-1"); } }
                MenuItem { title: "No rating"; activated => { root.act("rate-0"); } }
            }
            if item.fav >= 0: MenuItem {
                title: item.fav == 1 ? "Remove from Favorites" : "Add to Favorites";
                activated => { root.act("fav"); }
            }

            // Playlist items.
            if (item.kind == 0 || item.kind == 11) && root.album-tracks == false: MenuItem {
                title: root.hearted ? "Unheart" : "Remove from this playlist";
                enabled: item.dim == false;
                activated => { root.act("pl-remove"); }
            }
            // Stations.
            if item.kind == 6: MenuSeparator {}
            if item.kind == 6: MenuItem { title: "Edit…"; activated => { root.act("st-edit"); } }
            if item.kind == 6: MenuItem { title: "Test"; activated => { root.act("st-test"); } }
            if item.kind == 6: MenuItem { title: "Move up"; activated => { root.act("st-up"); } }
            if item.kind == 6: MenuItem { title: "Move down"; activated => { root.act("st-down"); } }
            if item.kind == 6: MenuItem { title: "Delete…"; activated => { root.act("st-delete"); } }
            // Podcasts and episodes.
            if item.kind == 7: MenuSeparator {}
            if item.kind == 7: MenuItem { title: "Unsubscribe…"; activated => { root.act("unsubscribe"); } }
            if item.kind == 8: MenuSeparator {}
            if item.kind == 8: MenuItem {
                title: item.downloaded ? "Delete download" : "Download";
                activated => { root.act(item.downloaded ? "dl-delete" : "download"); }
            }
            if item.kind == 8: MenuItem {
                title: item.dim ? "Mark as not played" : "Mark as played";
                activated => { root.act("played"); }
            }
            // Offline.
            if item.can-pin: MenuSeparator {}
            if item.can-pin: MenuItem {
                title: item.pinned ? "Stop keeping offline" : "Keep offline";
                activated => { root.act("pin"); }
            }
            if item.kind == 13: MenuSeparator {}
            if item.kind == 13: MenuItem { title: "Unpin"; activated => { root.act("unpin"); } }
            // Saved mixes.
            if item.kind == 16: MenuSeparator {}
            if item.kind == 16: MenuItem { title: "Rename…"; activated => { root.act("mix-rename"); } }
            if item.kind == 16: MenuItem { title: "Delete…"; activated => { root.act("mix-delete"); } }
            // Downloads.
            if item.kind == 14: MenuItem {
                title: item.on ? "Resume" : "Pause";
                activated => { root.act("job-pause"); }
            }
            if item.kind == 14: MenuItem { title: "Cancel"; activated => { root.act("job-cancel"); } }
            // Playlists.
            if item.kind == 5 && !item.fixed: MenuSeparator {}
            if item.kind == 5 && !item.fixed: MenuItem { title: "Rename…"; activated => { root.act("pl-rename"); } }
            if item.kind == 5 && !item.fixed: MenuItem { title: "Delete…"; activated => { root.act("pl-delete"); } }
        }
        // A long press on a touch screen opens the same menu.
        hold := Timer {
            interval: LongPress.after;
            running: false;
            triggered => {
                self.running = false;
                if ta.pressed && item.selectable && root.has-menu {
                    root.long-fired = true;
                    cm.show({ x: ta.mouse-x, y: ta.mouse-y });
                } else if ta.pressed && root.title-cut && item.kind != 12 {
                    root.long-fired = true;
                    Peek.show(root.title-full, ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                }
            }
        }
        ta := TouchArea {
            mouse-cursor: item.selectable ? pointer : default;
            // The TouchArea sees the press before the menu area does, so
            // a right press opens the menu from here.
            pointer-event(e) => {
                // A row with no menu: its cut title in a bubble instead.
                if e.kind == PointerEventKind.down && !item.selectable && item.kind != 12 && root.title-cut {
                    root.long-fired = false;
                    if e.button == PointerEventButton.right {
                        Peek.show(root.title-full, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else if e.button == PointerEventButton.left {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        hold.running = false;
                        hold.running = true;
                    }
                }
                if e.kind == PointerEventKind.down && item.selectable {
                    root.long-fired = false;
                    root.select();
                    if e.button == PointerEventButton.right {
                        if root.has-menu { cm.show({ x: self.mouse-x, y: self.mouse-y }); }
                    } else if e.button == PointerEventButton.left && Ui.touch && root.has-menu {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        hold.running = false;
                        hold.running = true;
                    }
                }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    hold.running = false;
                }
            }
            moved => {
                if abs(self.mouse-x - root.press-x) > LongPress.slop || abs(self.mouse-y - root.press-y) > LongPress.slop {
                    hold.running = false;
                }
            }
            // One click or tap opens a folder, artist or album, or plays a
            // song or station. Settings rows act through their own controls.
            clicked => {
                if !root.long-fired && item.selectable && item.kind != 12 { root.activate(); }
            }
        }
    }

    // A settings row: label and help on the left, its control on the
    // right. Laid over the row's touch area so the buttons get the clicks.
    // Greyed out (leveling under bit-perfect) shows faded, its help line
    // saying why, and a click on its control just says why again.
    if item.kind == 12: Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: item.off ? 0.45 : 1.0;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 16px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: item.title;
                    font-size: 13px;
                    color: item.ctl == 5 ? P.text : P.text;
                    font-family: item.ctl == 5 ? P.mono : P.sans;
                    overflow: elide;
                    PeekArea {
                        full: parent.text;
                        cut: parent.preferred-width > parent.width + 0.5px;
                        down => { if item.selectable { root.select(); } }
                    }
                }
                if item.meta != "": Text {
                    text: item.meta;
                    font-size: 11.5px;
                    color: P.muted;
                    overflow: elide;
                    PeekArea {
                        full: parent.text;
                        cut: parent.preferred-width > parent.width + 0.5px;
                        down => { if item.selectable { root.select(); } }
                    }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: 6px;
                if item.ctl == 1: Rectangle {
                    width: 36px;
                    Switch {
                        y: (parent.height - self.height) / 2;
                        on: item.on;
                        toggled => { root.act("toggle"); }
                    }
                }
                if item.ctl == 2: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    max-width: 340px;
                    text: item.sub + "  ▾";
                    peek: item.sub;
                    clicked => { root.act("choose"); }
                }
                if item.ctl == 3: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "−";
                    clicked => { root.act("dec"); }
                }
                if item.ctl == 3: Rectangle {
                    min-width: 72px;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: item.sub;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-family: P.mono;
                        font-size: 12px;
                        color: P.text;
                    }
                    TouchArea {
                        mouse-cursor: text;
                        clicked => { root.act("edit"); }
                    }
                }
                if item.ctl == 3: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "+";
                    clicked => { root.act("inc"); }
                }
                if item.ctl == 4: Text {
                    max-width: 300px;
                    text: item.sub;
                    vertical-alignment: center;
                    font-family: P.mono;
                    font-size: 12px;
                    color: item.on ? P.text : P.muted;
                    overflow: elide;
                    PeekArea {
                        full: parent.text;
                        cut: parent.preferred-width > parent.width + 0.5px;
                        down => { if item.selectable { root.select(); } }
                    }
                }
                if item.ctl == 4: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Edit";
                    clicked => { root.act("edit"); }
                }
                if item.ctl == 5: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Remove";
                    danger: true;
                    clicked => { root.act("remove"); }
                }
                if item.ctl == 6: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Browse…";
                    primary: true;
                    clicked => { root.act("browse"); }
                }
                if item.ctl == 6: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Type a path…";
                    clicked => { root.act("edit"); }
                }
                // A music server: sync it, edit it, remove it.
                if item.ctl == 8: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Sync now";
                    clicked => { root.act("sync"); }
                }
                if item.ctl == 8: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Edit";
                    clicked => { root.act("srv-edit"); }
                }
                if item.ctl == 8: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Remove";
                    danger: true;
                    clicked => { root.act("srv-remove"); }
                }
                if item.ctl == 9: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Add server…";
                    primary: true;
                    clicked => { root.act("add-server"); }
                }
                if item.ctl == 10: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: "Find servers…";
                    primary: true;
                    clicked => { root.act("find-dlna"); }
                }
                if item.ctl == 11: Chip {
                    y: (parent.height - self.height) / 2;
                    h: 28px;
                    text: item.sub;
                    clicked => { root.act("measure"); }
                }
                if item.ctl == 7: Text {
                    max-width: 520px;
                    text: item.sub;
                    vertical-alignment: center;
                    font-family: P.mono;
                    font-size: 11.5px;
                    color: P.muted;
                    overflow: elide;
                    PeekArea {
                        full: parent.text;
                        cut: parent.preferred-width > parent.width + 0.5px;
                        down => { if item.selectable { root.select(); } }
                    }
                }
            }
        }
    }
}

component AlbumTile inherits Rectangle {
    in property <Row> item;
    in property <bool> selected;
    callback select;
    callback activate;
    callback act(string);
    property <bool> long-fired;
    property <length> press-x;
    property <length> press-y;
    border-radius: 8px * P.round;
    background: selected ? P.raised : (ta.has-hover ? P.hover : transparent);
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: self.width;
            Cover {
                width: parent.width;
                height: parent.height;
                art: item.art;
                has-art: item.has-art;
                radius: 6px;
                // Its server is away and none of it is kept: faded.
                opacity: item.off ? 0.35 : 1.0;
            }
            // Pinned for offline: a badge in the corner.
            if item.pinned: Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: P.verdigris;
                Text {
                    text: "↓";
                    color: P.on-accent;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        tile-title := Text {
            text: item.title;
            overflow: elide;
            font-size: 13px;
            font-weight: P.kawaii ? 700 : 600;
            color: item.playing ? P.accent-text : (item.off ? P.wave : P.text);
        }
        // A rated album shows its stars after the artist.
        tile-sub := Text {
            text: item.stars != "" ? item.sub + "  " + item.stars : item.sub;
            overflow: elide;
            font-size: 12px;
            color: item.off ? P.wave : P.muted;
        }
    }
    tcm := ContextMenuArea {
        Menu {
            // The whole name, when the tile cuts it short.
            if tile-title.preferred-width > tile-title.width + 0.5px: MenuItem { title: item.title; enabled: false; }
            if tile-sub.preferred-width > tile-sub.width + 0.5px: MenuItem { title: item.sub; enabled: false; }
            if tile-title.preferred-width > tile-title.width + 0.5px || tile-sub.preferred-width > tile-sub.width + 0.5px: MenuSeparator {}
            MenuItem { title: "Play"; activated => { root.act("play"); } }
            MenuItem { title: "Play next"; activated => { root.act("next"); } }
            MenuItem { title: "Add to queue"; activated => { root.act("queue"); } }
            MenuItem { title: "Add to playlist…"; activated => { root.act("playlist"); } }
            if item.can-mix: MenuItem { title: "Artist mix"; activated => { root.act("mix"); } }
            // Ratings and favorites.
            if item.rating >= 0 || item.fav >= 0: MenuSeparator {}
            if item.rating >= 0: Menu {
                title: item.rating > 0 ? "Rated " + item.stars : "Rate";
                MenuItem { title: "★★★★★"; activated => { root.act("rate-5"); } }
                MenuItem { title: "★★★★"; activated => { root.act("rate-4"); } }
                MenuItem { title: "★★★"; activated => { root.act("rate-3"); } }
                MenuItem { title: "★★"; activated => { root.act("rate-2"); } }
                MenuItem { title: "★"; activated => { root.act("rate-1"); } }
                MenuItem { title: "No rating"; activated => { root.act("rate-0"); } }
            }
            if item.fav >= 0: MenuItem {
                title: item.fav == 1 ? "Remove from Favorites" : "Add to Favorites";
                activated => { root.act("fav"); }
            }
            if item.can-pin: MenuSeparator {}
            if item.can-pin: MenuItem {
                title: item.pinned ? "Stop keeping offline" : "Keep offline";
                activated => { root.act("pin"); }
            }
        }
        hold := Timer {
            interval: LongPress.after;
            running: false;
            triggered => {
                self.running = false;
                if ta.pressed {
                    root.long-fired = true;
                    tcm.show({ x: ta.mouse-x, y: ta.mouse-y });
                }
            }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.long-fired = false;
                    root.select();
                    if e.button == PointerEventButton.right {
                        tcm.show({ x: self.mouse-x, y: self.mouse-y });
                    } else if e.button == PointerEventButton.left && Ui.touch {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        hold.running = false;
                        hold.running = true;
                    }
                }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    hold.running = false;
                }
            }
            moved => {
                if abs(self.mouse-x - root.press-x) > LongPress.slop || abs(self.mouse-y - root.press-y) > LongPress.slop {
                    hold.running = false;
                }
            }
            clicked => {
                if !root.long-fired { root.activate(); }
            }
        }
    }
}

// One entry in the Queue view. A click or tap plays it; right-click, or
// a long press on a touch screen, opens its menu.
component QueueLine inherits Rectangle {
    in property <QueueRow> q;
    in property <int> n;
    in property <bool> selected;
    callback select;
    callback activate;
    callback act(string);
    property <bool> long-fired;
    property <length> press-x;
    property <length> press-y;
    height: 52px;
    border-radius: 6px * P.round;
    border-width: q.playing && P.kawaii ? 2px : 0px;
    border-color: P.verdigris;
    background: q.playing ? P.playing-bg : (selected ? P.raised : (qta.has-hover ? P.hover : transparent));
    HorizontalLayout {
        padding: 6px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            width: 32px;
            text: q.playing ? (P.kawaii ? "♪" : "▶") : root.n;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: P.mono;
            font-size: 12px;
            color: q.playing ? P.accent-text : (P.kawaii ? P.muted : P.wave);
        }
        Cover { width: 40px; height: 40px; radius: 4px; art: q.art; has-art: q.has-art; }
        VerticalLayout {
            alignment: center;
            line-title := Text { text: q.title; overflow: elide; font-weight: q.playing ? 700 : 400; color: q.failed ? P.copper : (q.playing ? P.accent-text : (q.off ? P.wave : P.text)); }
            line-sub := Text { text: q.sub; overflow: elide; font-size: 12px; color: P.muted; }
        }
    }
    qcm := ContextMenuArea {
        Menu {
            // The whole title and artist, when the line cuts them short.
            if line-title.preferred-width > line-title.width + 0.5px: MenuItem { title: q.title; enabled: false; }
            if line-sub.preferred-width > line-sub.width + 0.5px: MenuItem { title: q.sub; enabled: false; }
            if line-title.preferred-width > line-title.width + 0.5px || line-sub.preferred-width > line-sub.width + 0.5px: MenuSeparator {}
            MenuItem { title: "Play"; activated => { root.act("play"); } }
            MenuItem { title: "Move up"; activated => { root.act("up"); } }
            MenuItem { title: "Move down"; activated => { root.act("down"); } }
            MenuItem { title: "Add to playlist…"; activated => { root.act("playlist"); } }
            MenuSeparator {}
            MenuItem { title: "Go to album"; activated => { root.act("go-album"); } }
            MenuItem { title: "Go to artist"; activated => { root.act("go-artist"); } }
            MenuSeparator {}
            MenuItem { title: "Remove"; activated => { root.act("remove"); } }
        }
        hold := Timer {
            interval: LongPress.after;
            running: false;
            triggered => {
                self.running = false;
                if qta.pressed {
                    root.long-fired = true;
                    qcm.show({ x: qta.mouse-x, y: qta.mouse-y });
                }
            }
        }
        qta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.long-fired = false;
                    root.select();
                    if e.button == PointerEventButton.right {
                        qcm.show({ x: self.mouse-x, y: self.mouse-y });
                    } else if e.button == PointerEventButton.left && Ui.touch {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        hold.running = false;
                        hold.running = true;
                    }
                }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    hold.running = false;
                }
            }
            moved => {
                if abs(self.mouse-x - root.press-x) > LongPress.slop || abs(self.mouse-y - root.press-y) > LongPress.slop {
                    hold.running = false;
                }
            }
            clicked => {
                if !root.long-fired { root.activate(); }
            }
        }
    }
}

// ----- Main window -----


// A dial for the rack. Drag up or down to turn it; a choice steps on a
// click instead.
component Knob inherits Rectangle {
    in property <AmpKnob> k;
    in property <bool> lit;
    callback turned(float);
    callback stepped();
    width: 58px;
    height: 76px;
    property <float> grab-pos;
    property <length> grab-y;
    VerticalLayout {
        spacing: 2px;
        alignment: start;
        Rectangle {
            height: 42px;
            if !root.k.choice: Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: P.raised;
                border-width: 1px;
                border-color: ta.has-hover || ta.pressed ? P.copper : P.border;
                // The track, then the lit part over it.
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: "M 23.1 76.9 A 38 38 0 1 1 76.9 76.9";
                    stroke: P.wave;
                    stroke-width: 3px;
                }
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: root.k.arc;
                    stroke: root.lit ? P.copper : P.muted;
                    stroke-width: 3px;
                }
            }
            if root.k.choice: Rectangle {
                y: 9px;
                height: 24px;
                width: 54px;
                border-radius: 5px * P.round;
                border-width: 1px;
                border-color: ta.has-hover ? P.copper : P.border;
                background: P.raised;
                Text {
                    text: root.k.text;
                    font-size: 10.5px;
                    color: root.lit ? P.copper : P.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea {
                mouse-cursor: root.k.choice ? pointer : ns-resize;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.grab-pos = root.k.pos;
                        root.grab-y = self.mouse-y;
                    }
                }
                moved => {
                    if self.pressed && !root.k.choice {
                        root.turned(max(0, min(1, root.grab-pos + (root.grab-y - self.mouse-y) / 140px)));
                    }
                }
                clicked => {
                    if root.k.choice { root.stepped(); }
                }
            }
        }
        Text {
            text: root.k.label;
            font-size: 10.5px;
            color: P.text;
            horizontal-alignment: center;
            overflow: elide;
            PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
        }
        if !root.k.choice: Text {
            text: root.k.text;
            font-family: P.mono;
            font-size: 9.5px;
            color: P.muted;
            horizontal-alignment: center;
            overflow: elide;
            PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
        }
    }
}

// One control of a rack unit as a row: its name, a slider that drags
// sideways, and its value. A choice is a button that steps. This is the
// rack on a touch screen or a narrow window, where a dial dragged up and
// down fights the page's own scrolling and is too small for a finger.
component AmpRow inherits Rectangle {
    in property <AmpKnob> k;
    in property <bool> lit;
    callback turned(float);
    callback stepped();
    height: 44px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            width: 96px;
            text: root.k.label;
            vertical-alignment: center;
            font-size: 12.5px;
            color: P.text;
            overflow: elide;
            PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
        }
        if !root.k.choice: Bar {
            horizontal-stretch: 1;
            height: 44px;
            label: root.k.label;
            value: root.k.pos;
            live: true;
            wheel: false;
            show-knob: true;
            knob: 20px;
            fill: root.lit ? P.copper : P.muted;
            changed(v) => { root.turned(v); }
        }
        if !root.k.choice: Text {
            width: 70px;
            text: root.k.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: P.mono;
            font-size: 11.5px;
            color: P.muted;
            overflow: elide;
            PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
        }
        if root.k.choice: Rectangle {
            horizontal-stretch: 1;
            Chip {
                x: 0;
                y: (parent.height - self.height) / 2;
                h: 36px;
                text: root.k.text + "   ›";
                peek: root.k.text;
                active: root.lit;
                clicked => { root.stepped(); }
            }
        }
    }
}

// The amp stack as a rack: one unit per device, in signal order, each
// with its on light and dials. The rows under it hold everything else.
component AmpPanel inherits Rectangle {
    in property <[AmpUnit]> units;
    in property <bool> on;
    in property <string> info;
    // Units stacked as cards of sliders instead of a row of dials.
    in property <bool> compact;
    callback knob(int, int, float);
    callback step(int, int);
    callback unit-toggle(int);
    callback act(string);
    border-radius: 8px * P.round;
    background: P.surface;
    border-width: 1px;
    border-color: P.border;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.info;
                font-size: 12.5px;
                color: P.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
            }
            Chip { h: 28px; text: root.on ? "On" : "Bypassed"; active: root.on; clicked => { root.act("amp-toggle"); } }
            Chip { h: 28px; text: "Save as…"; clicked => { root.act("amp-save"); } }
        }
        if !root.compact: Flickable {
            height: 132px;
            content-width: max(self.width, rack.preferred-width);
            rack := HorizontalLayout {
                spacing: 10px;
                alignment: start;
                if root.units.length == 0: Text {
                    text: "The rack is empty. Pick a preset or add a device below.";
                    color: P.muted;
                    vertical-alignment: center;
                }
                for u[i] in root.units: Rectangle {
                    width: max(140px, u.knobs.length * 60px + 16px);
                    border-radius: 6px * P.round;
                    border-width: 1px;
                    border-color: u.on && root.on ? P.copper-dim : P.border;
                    background: P.raised.darker(0.15);
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            // The on light.
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                y: 3px;
                                border-radius: 5px;
                                background: u.on && root.on ? P.copper : P.wave;
                                drop-shadow-blur: u.on && root.on ? 6px : 0px;
                                drop-shadow-color: P.copper;
                                TouchArea { mouse-cursor: pointer; clicked => { root.unit-toggle(i); } }
                            }
                            Text {
                                text: u.name;
                                font-family: P.serif;
                                font-weight: 700;
                                font-size: 12.5px;
                                color: u.on && root.on ? P.text : P.muted;
                                overflow: elide;
                                PeekArea {
                                    mouse-cursor: pointer;
                                    full: parent.text;
                                    cut: parent.preferred-width > parent.width + 0.5px;
                                    tapped => { root.unit-toggle(i); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            for k[j] in u.knobs: Knob {
                                k: k;
                                lit: u.on && root.on;
                                turned(p) => { root.knob(i, j, p); }
                                stepped => { root.step(i, j); }
                            }
                        }
                    }
                }
            }
        }
        if root.compact && root.units.length == 0: Text {
            text: "The rack is empty. Pick a preset or add a device below.";
            color: P.muted;
            wrap: word-wrap;
        }
        if root.compact: VerticalLayout {
            spacing: 10px;
            for u[i] in root.units: Rectangle {
                border-radius: 6px * P.round;
                border-width: 1px;
                border-color: u.on && root.on ? P.copper-dim : P.border;
                background: P.raised.darker(0.15);
                VerticalLayout {
                    padding: 10px;
                    padding-top: 4px;
                    spacing: 0px;
                    // The unit's name and its switch; the whole line toggles it.
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 12px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: u.on && root.on ? P.copper : P.wave;
                                    drop-shadow-blur: u.on && root.on ? 6px : 0px;
                                    drop-shadow-color: P.copper;
                                }
                            }
                            unit-name := Text {
                                horizontal-stretch: 1;
                                text: u.name;
                                vertical-alignment: center;
                                font-family: P.serif;
                                font-weight: 700;
                                font-size: 14px;
                                color: u.on && root.on ? P.text : P.muted;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 36px;
                                Switch {
                                    y: (parent.height - self.height) / 2;
                                    on: u.on;
                                    toggled => { root.unit-toggle(i); }
                                }
                            }
                        }
                        PeekArea {
                            full: u.name;
                            cut: unit-name.preferred-width > unit-name.width + 0.5px;
                            tapped => { root.unit-toggle(i); }
                        }
                    }
                    for k[j] in u.knobs: AmpRow {
                        k: k;
                        lit: u.on && root.on;
                        turned(p) => { root.knob(i, j, p); }
                        stepped => { root.step(i, j); }
                    }
                }
            }
        }
    }
}

// The EQ's response curve, with a handle per band. Graphic bands drag up
// and down; parametric ones drag anywhere (frequency and gain).
component EqPanel inherits Rectangle {
    in property <string> curve;
    in property <[EqBand]> bands;
    in property <float> range: 12;
    in property <bool> on;
    in property <bool> graphic;
    in property <string> info;
    callback point(int, float, float);
    callback act(string);
    border-radius: 8px * P.round;
    background: P.surface;
    border-width: 1px;
    border-color: P.border;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.info;
                font-size: 12.5px;
                color: P.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
            }
            HScroll {
                horizontal-stretch: 0;
                max-width: self.preferred-width;
                Chip { h: 28px; text: root.on ? "On" : "Bypassed"; active: root.on; clicked => { root.act("eq-toggle"); } }
                Chip { h: 28px; text: "Flat"; clicked => { root.act("eq-flat"); } }
                Chip { h: 28px; text: "Import…"; clicked => { root.act("eq-import"); } }
                Chip { h: 28px; text: "Save as…"; clicked => { root.act("eq-save"); } }
            }
        }
        graph := Rectangle {
            vertical-stretch: 1;
            min-height: 150px;
            clip: true;
            // Grid: 100 Hz, 1 kHz, 10 kHz, and 0 dB.
            // log10(f / 20) / 3 across: 100 Hz, 1 kHz, 10 kHz.
            for f in [0.233, 0.566, 0.899]: Rectangle {
                x: parent.width * f;
                width: 1px;
                background: P.border;
            }
            Rectangle { y: parent.height / 2; height: 1px; background: P.wave; }
            Text { x: 4px; y: 2px; text: "+" + round(root.range) + " dB"; font-size: 10.5px; color: P.muted; }
            Text { x: 4px; y: parent.height - 14px; text: "-" + round(root.range) + " dB"; font-size: 10.5px; color: P.muted; }
            Text { x: parent.width * 0.233 + 3px; y: 2px; text: "100 Hz"; font-size: 10.5px; color: P.muted; }
            Text { x: parent.width * 0.566 + 3px; y: 2px; text: "1 kHz"; font-size: 10.5px; color: P.muted; }
            Text { x: parent.width * 0.899 + 3px; y: 2px; text: "10 kHz"; font-size: 10.5px; color: P.muted; }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 200;
                // Stretched to the graph, not kept at 5:1 and centred:
                // otherwise the curve drifts off the handles whenever the
                // window isn't exactly that shape.
                fit: fill;
                commands: root.curve;
                stroke: root.on ? (P.kawaii ? P.mint : P.verdigris) : P.wave;
                stroke-width: 2px;
            }
            for b[i] in root.bands: Rectangle {
                // Graphic: the whole column is the slider.
                x: root.graphic ? parent.width * b.x - (parent.width / root.bands.length) / 2 : parent.width * b.x - 9px;
                y: root.graphic ? 0px : parent.height * (0.5 - b.gain / (2 * root.range)) - 9px;
                width: root.graphic ? parent.width / root.bands.length : 18px;
                height: root.graphic ? parent.height : 18px;
                Rectangle {
                    x: (parent.width - 12px) / 2;
                    y: root.graphic ? parent.height * (0.5 - b.gain / (2 * root.range)) - 6px : 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: ta.pressed || ta.has-hover ? P.copper : (root.on ? P.verdigris : P.wave);
                    border-width: 2px;
                    border-color: P.surface;
                }
                if root.graphic: Text {
                    y: parent.height - 28px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: b.label;
                    font-size: 10px;
                    color: P.muted;
                    visible: root.bands.length <= 15 || mod(i, 2) == 0;
                }
                ta := TouchArea {
                    mouse-cursor: root.graphic ? ns-resize : move;
                    // Where the pointer is on the graph, as frequency
                    // (0 to 1 across) and gain.
                    function at(mx: length, my: length) {
                        root.point(
                            i,
                            max(0, min(1, (parent.x + mx) / graph.width)),
                            max(-root.range, min(root.range, (0.5 - (parent.y + my) / graph.height) * 2 * root.range)));
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            self.at(self.mouse-x, self.mouse-y);
                        }
                    }
                    moved => {
                        if self.pressed { self.at(self.mouse-x, self.mouse-y); }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "PatinaPlayer";
    icon: @image-url("../../../assets/patinaplayer.png");
    preferred-width: 1360px;
    preferred-height: 860px;
    // Small enough for a phone-sized window. The layout steps down in
    // tiers as the window narrows, and the views scroll when it's short.
    min-width: 360px;
    min-height: 420px;
    background: P.bg;

    // The window's size, copied over when it changes. The tiers below hang
    // off these copies rather than the size itself: the tiers change what
    // the layout needs, and the layout feeds the window's size, so binding
    // to it directly would be a loop. Rust sets them too, every tick, from
    // the window's real size: `changed` only fires on a change, and a
    // window that opens at its final size (a phone, a tablet) never
    // changes, which left the tiers working from the 1360px default.
    in-out property <length> win-w: 1360px;
    in-out property <length> win-h: 860px;
    changed width => { self.win-w = self.width; }
    changed height => { self.win-h = self.height; }
    // Size tiers, widest first.
    // compact: the bottom bar drops the format badge and output chip.
    out property <bool> compact: win-w < 1180px;
    // narrow: the sidebar folds to icons, unless a setting says otherwise.
    out property <bool> narrow: win-w < 1000px;
    // The sidebar setting for each way the screen is held: 0 by width (as
    // above), 1 always expanded, 2 always folded to icons.
    in property <int> side-land: 0;
    in property <int> side-port: 0;
    out property <bool> landscape: win-w >= win-h;
    property <int> side-mode: landscape ? side-land : side-port;
    // Folded to icons, by width or by choice.
    out property <bool> side-folded: side-mode == 2 || (side-mode == 0 && narrow && !tiny);
    // A drawer behind the menu button: a tiny window, unless the sidebar
    // is set to stay folded, which keeps the icons on screen.
    out property <bool> drawer: tiny && side-mode != 2;
    // The fold button: fold (true) or expand, for this way of holding it.
    callback side-fold(bool, bool);
    // tight: the bottom bar takes two rows, view buttons go under the title.
    // (The bar also goes to two rows by itself when one won't fit.)
    out property <bool> tight: win-w < 820px;
    // tiny: the sidebar becomes a drawer, side panels cover the view.
    out property <bool> tiny: win-w < 600px;
    // short: a smaller album header.
    property <bool> short: win-h < 700px;
    in-out property <bool> drawer-open: false;
    property <length> side-w: drawer ? 0px : (side-folded ? 64px : 228px);
    property <length> bar-h: bar.two-row ? 132px : 84px;
    property <length> lyrics-w: tiny ? 0px : clamp(win-w * 0.3, 240px, 340px);
    property <length> queue-w: tiny ? 0px : clamp(win-w * 0.26, 220px, 300px);
    property <length> pad: tight ? 16px : 32px;
    // A panel over the list on a phone or narrow window: the whole view
    // scrolls as one page, list and all.
    property <bool> page-scroll: (amp-panel || eq-panel) && (Ui.touch || tight);
    // Roughly the list's width, for the column header's choices.
    property <length> list-w: win-w - side-w - (lyrics-open ? lyrics-w : 0px) - (queue-panel ? queue-w : 0px) - 2 * pad;
    // The sidebar's hover label while it's folded to icons.
    property <string> side-tip;
    property <length> side-tip-y;
    default-font-family: P.sans;
    default-font-size: 13px;

    // Sidebar
    in property <[SideItem]> side;
    in property <int> side-sel: -1;
    callback side-clicked(int);

    // Header
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <string> search-text;
    callback back;
    callback forward;
    callback search-edited(string);
    callback search-cancel;
    // Text is typed in the system's own dialogs (Android): the text dialog
    // below isn't drawn, and a tap on the search box opens the system's.
    in property <bool> native-text: false;
    callback search-tapped;

    // The open view
    in property <[string]> crumbs;
    in property <string> view-title;
    in property <string> view-sub;
    in property <string> empty-text;
    // 0 list, 1 album grid, 2 queue
    in property <int> layout;
    in property <[Row]> rows;
    // Every row's height added up (ListRow's heights, from Rust).
    in property <length> rows-height;
    in property <[string]> columns;
    // Rows in this level carry a cover thumbnail (albums, folders).
    in property <bool> covers;
    in property <int> selected: -1;
    in property <bool> album-tracks;
    // The open list is Hearted songs.
    in property <bool> hearted-open;
    in property <Hero> hero;
    in property <[string]> actions;
    in property <[string]> action-labels;
    callback row-select(int);
    callback row-activate(int);
    callback row-act(int, string);
    callback view-action(string);
    callback crumb-clicked(int);

    // Queue (as a view and as the side panel)
    in property <[QueueRow]> queue;
    // What's scrolled into view, so Rust loads covers only for those rows.
    out property <int> list-first: floor(-list.content-y / 40px);
    out property <int> list-count: ceil(list.visible-height / 34px) + 1;
    out property <int> grid-cols: grid.cols;
    out property <int> grid-first: floor(-grid.content-y / (grid.cell + 44px)) * grid.cols;
    out property <int> grid-count: (ceil(grid.height / (grid.cell + 44px)) + 1) * grid.cols;
    out property <int> qlist-first: floor(-qlist.content-y / 52px);
    out property <int> qlist-count: ceil(qlist.visible-height / 52px) + 1;
    in-out property <length> panel-scroll;
    out property <int> panel-first: floor(-panel-scroll / 54px);
    out property <int> panel-count: ceil(root.height / 54px) + 1;
    in property <int> queue-sel: -1;
    in property <int> queue-current: -1;
    in property <string> queue-summary;
    in-out property <bool> queue-panel: false;
    callback queue-select(int);
    callback queue-activate(int);
    callback queue-act(int, string);
    callback queue-save;
    callback queue-clear;
    // Servers that keep a play queue: "Queue from <name>" loads theirs.
    in property <[string]> queue-servers;
    // A mix is playing that isn't saved yet.
    in property <bool> queue-mix-unsaved;
    callback queue-load(string);

    // Now playing
    in property <string> np-title;
    in property <string> np-sub;
    // Love on the song playing: 0 none (no song, radio), 1 not loved, 2 loved.
    in property <int> love-state;
    callback love-clicked;
    // The song playing: its rating, 0 to 5; -1 when it can't have one.
    in property <int> np-rating: -1;
    callback np-rate(int);
    // Album headers: stars and the favorite toggle.
    callback hero-rate(int);
    callback hero-fav;
    // Sidebar favorites: move up, move down, remove.
    callback side-act(int, string);
    // Lyrics, shown in a panel on the right.
    in property <bool> lyrics-open;
    in property <string> lyrics-title;
    in property <string> lyrics-note;
    in property <bool> lyrics-warn;
    in property <[string]> lyrics-lines;
    // The playing line among them; -1 for none (unsynced).
    in property <int> lyrics-current: -1;
    in property <bool> lyrics-synced;
    callback lyrics-clicked;
    in property <image> np-art;
    in property <bool> np-has-art;
    in property <bool> playing;
    in property <bool> live;
    in property <bool> has-track;
    in property <float> position;
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> badge;
    // "BIT-PERFECT", "EXCLUSIVE", or "NOT BIT-PERFECT" when it was refused.
    in property <string> bp-badge;
    in property <int> bp-tone; // 0 good, 1 plain, 2 refused
    in property <string> bp-tip;
    callback bp-clicked;
    // The leveling gain on what's playing ("-4.2 dB"), and where it's from.
    // The EQ view's panel, and the bottom bar's EQ and limiter chips.
    in property <bool> eq-panel;
    in property <string> eq-curve;
    in property <[EqBand]> eq-bands;
    in property <float> eq-range: 12;
    in property <bool> eq-on;
    in property <bool> eq-graphic;
    in property <string> eq-info;
    callback eq-point(int, float, float);
    in property <bool> eq-lit;
    // The Amp view's rack, and the bottom bar's AMP badge.
    in property <bool> amp-panel;
    in property <[AmpUnit]> amp-units;
    in property <bool> amp-on;
    in property <string> amp-info;
    in property <bool> amp-lit;
    callback amp-knob(int, int, float);
    callback amp-step(int, int);
    callback amp-unit-toggle(int);
    callback amp-chip;
    in property <string> limit-label;
    callback eq-chip;
    in property <string> level-label;
    in property <string> level-tip;
    callback level-clicked;
    // Bit-perfect on a DAC with no volume control: fixed at 100%.
    in property <bool> volume-locked;
    in property <string> output-label;
    // Click the output chip to pick a device.
    callback output-clicked;
    // "44.1→48k" while the song is resampled.
    in property <string> resample-label;
    in property <string> speed-label;
    in property <string> status-line;
    in property <bool> status-warn;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one
    in property <int> repeat;
    in property <float> volume;
    // The volume as people read it: "64%". Fixed at 100% for bit-perfect.
    property <string> volume-pct: (root.volume-locked ? 100 : round(clamp(root.volume, 0, 1) * 100)) + "%";
    // The volume popup on a touch screen, opened from the volume button.
    in-out property <bool> volume-open;
    in property <bool> muted;
    callback play-pause;
    callback prev;
    callback next;
    callback toggle-shuffle;
    callback cycle-repeat;
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute;
    callback toggle-queue;
    callback speed-clicked;

    // Toast
    in property <string> toast;
    in property <bool> toast-error;

    // Dialogs: 0 none, 1 text form, 2 pick playlist, 3 confirm, 4 help
    in-out property <int> dialog;
    in property <string> dlg-title;
    in property <string> dlg-label1;
    in property <string> dlg-label2;
    in-out property <string> dlg-text1;
    in-out property <string> dlg-text2;
    in property <bool> dlg-two-fields;
    // The server form: two more fields, the last one a password.
    in property <bool> dlg-four-fields;
    in property <string> dlg-label3;
    in property <string> dlg-label4;
    in-out property <string> dlg-text3;
    in-out property <string> dlg-text4;
    in property <string> dlg-ok;
    in property <string> dlg-message;
    in property <[string]> dlg-items;
    // The pick list starts with "New playlist…", drawn in the accent.
    in property <bool> dlg-new-first;
    callback dlg-accept;
    callback dlg-pick(int);
    callback dlg-cancel;

    // Keys not taken by a text field.
    callback key(string, bool, bool, bool) -> bool;

    public function focus-root() { keys.focus(); }
    public function focus-search() { search-input.focus(); search-input.select-all(); }
    public function scroll-to(index: int) {
        if layout == 0 {
            if index * 40px < list.content-y * -1 {
                list.content-y = -index * 40px;
            } else if (index + 1) * 40px > -list.content-y + list.visible-height {
                list.content-y = -((index + 1) * 40px - list.visible-height);
            }
        }
        if layout == 2 {
            if index * 52px < qlist.content-y * -1 {
                qlist.content-y = -index * 52px;
            } else if (index + 1) * 52px > -qlist.content-y + qlist.visible-height {
                qlist.content-y = -((index + 1) * 52px - qlist.visible-height);
            }
        }
    }
    public function scroll-top() {
        list.content-y = 0;
        body.content-y = 0;
        grid.content-y = 0;
    }

    // Kawaii: a faint dot pattern behind the views.
    if P.kawaii: Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("dot.png");
        horizontal-tiling: ImageTiling.repeat;
        vertical-tiling: ImageTiling.repeat;
        colorize: P.dots;
    }

    // Phones draw under the status and navigation bars: keep everything
    // inside the part of the screen that's safe to touch.
    keys := FocusScope {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        key-pressed(e) => {
            // A text shown whole closes first.
            if Peek.open && (e.text == Key.Escape || e.text == Key.Back) {
                Peek.open = false;
                return accept;
            }
            // Android's Back closes what's open first: a dialog, the
            // drawer, a side panel. Then it goes back a level, in Rust.
            if root.dialog != 0 {
                if e.text == Key.Escape || e.text == Key.Back { root.dlg-cancel(); return accept; }
                return reject;
            }
            if (e.text == Key.Back || e.text == Key.Escape) && root.volume-open {
                root.volume-open = false;
                return accept;
            }
            if e.text == Key.Back && root.drawer-open {
                root.drawer-open = false;
                return accept;
            }
            if e.text == Key.Back && root.tiny && root.queue-panel {
                root.toggle-queue();
                return accept;
            }
            if e.text == Key.Back && root.tiny && root.lyrics-open {
                root.lyrics-clicked();
                return accept;
            }
            if root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // The sidebar and side panels are drawn over these, below,
                // so on a tiny window they can slide over the view instead.
                Rectangle { width: root.side-w; }

                // ----- Main column -----
                VerticalLayout {
                    horizontal-stretch: 1;
                    // Header: back, forward, search
                    Rectangle {
                        height: 61px;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: P.border;
                        }
                        HorizontalLayout {
                            padding-left: root.tight ? 12px : 24px;
                            padding-right: root.tight ? 12px : 24px;
                            spacing: root.tiny ? 4px : 8px;
                            // Tiny window: the sidebar opens as a drawer.
                            if root.drawer: IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.menu;
                                tip: "Menu";
                                active: root.drawer-open;
                                clicked => { root.drawer-open = !root.drawer-open; keys.focus(); }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.back;
                                tip: "Back";
                                enabled: root.can-back;
                                clicked => { root.back(); keys.focus(); }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.forward;
                                tip: "Forward";
                                enabled: root.can-forward;
                                clicked => { root.forward(); keys.focus(); }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 100px;
                                preferred-width: 480px;
                                max-width: 480px;
                                height: 36px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px * P.round;
                                border-width: 1px;
                                border-color: search-input.has-focus ? P.verdigris-dim : P.border;
                                background: P.bg;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        d: Icons.search;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        clip: true;
                                        search-input := ScrollingInput {
                                            width: parent.width;
                                            height: parent.height;
                                            text <=> root.search-text;
                                            // Android types into its own search box (see
                                            // search-tapped), so this one only shows the text.
                                            enabled: !root.native-text;
                                            edited => { root.search-edited(self.text); }
                                            key-pressed(e) => {
                                                if e.text == Key.Escape {
                                                    root.search-cancel();
                                                    keys.focus();
                                                    return accept;
                                                }
                                                if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Return {
                                                    if root.key(e.text, false, false, false) { return accept; }
                                                }
                                                reject
                                            }
                                        }
                                        if search-input.text == "": Text {
                                            x: 0;
                                            width: parent.width;
                                            overflow: elide;
                                            text: root.tight ? "Search" : "Search artists, albums, songs";
                                            color: P.wave;
                                            vertical-alignment: center;
                                        }
                                        if root.native-text: TouchArea {
                                            clicked => { root.search-tapped(); }
                                        }
                                    }
                                    if !root.tiny: Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px * P.round;
                                        border-width: 1px;
                                        border-color: P.border;
                                        Text {
                                            text: "/";
                                            font-family: P.mono;
                                            font-size: 10.5px;
                                            color: P.muted;
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 0.001; }
                            if P.kawaii && !root.compact: Text {
                                text: P.light ? "ようこそ ♡ (｡•‿•｡)" : "おやすみ ☾ (っ˘ω˘ς )";
                                vertical-alignment: center;
                                font-size: 12px;
                                color: P.muted;
                            }
                        }
                    }

                    // View body. Whatever is inside, it never makes the window
                    // wider than it is: a row that doesn't fit scrolls or
                    // cuts off within it.
                    Rectangle {
                        vertical-stretch: 1;
                        min-width: 0px;
                        clip: true;

                        // Album hero and track list. When the window is too
                        // short for the header, panels and some of the list,
                        // the whole view scrolls; the list keeps a minimum.
                        body := Flickable {
                        visible: root.layout == 0;
                        content-height: lv.height;
                        content-width: self.width;
                        lv := VerticalLayout {
                            width: body.width;
                            height: max(body.height, self.min-height);
                            padding-left: root.pad;
                            padding-right: root.pad;
                            padding-top: root.hero.show ? (root.short ? 16px : 28px) : (root.short ? 12px : 20px);
                            spacing: 0px;

                            if root.hero.show: Rectangle {
                                // Kawaii: the hero is a rounded card with sparkles.
                                property <length> pad: P.kawaii ? 18px : 0px;
                                height: hl.preferred-height + (P.kawaii ? 22px : 0px);
                                Rectangle {
                                    y: 0;
                                    height: parent.height - (P.kawaii ? 22px : 0px);
                                    visible: P.kawaii;
                                    border-radius: 26px;
                                    border-width: 2px;
                                    border-color: P.border;
                                    background: P.surface;
                                }
                                if P.kawaii: Rectangle {
                                    x: parent.width - 92px;
                                    y: 18px;
                                    width: 70px;
                                    height: 16px;
                                    FilledIcon { x: 0; d: Icons.sparkle; size: 13px; fill: P.butter; }
                                    FilledIcon { x: 26px; y: 3px; d: Icons.sparkle; size: 9px; fill: P.mint; }
                                    FilledIcon { x: 46px; d: Icons.sparkle; size: 13px; fill: P.butter; }
                                }
                                hl := HorizontalLayout {
                                    y: 0;
                                    height: self.preferred-height;
                                    padding: parent.pad;
                                    spacing: root.tight ? 16px : 28px;
                                    padding-bottom: P.kawaii ? parent.pad : (root.short ? 16px : 24px);
                                    Cover {
                                        // Smaller on a small window.
                                        property <length> side: root.tiny ? 96px : (root.short || root.tight ? 136px : (P.kawaii ? 176px : 200px));
                                        width: self.side;
                                        height: self.side;
                                        art: root.hero.art;
                                        has-art: root.hero.has-art;
                                        radius: 8px;
                                    }
                                    VerticalLayout {
                                        alignment: end;
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        if !P.kawaii: Text {
                                            text: root.hero.kicker;
                                            font-size: 11px;
                                            letter-spacing: 0.9px;
                                            color: P.muted;
                                        }
                                        if P.kawaii: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                width: kt.preferred-width + 22px;
                                                height: 22px;
                                                border-radius: 11px;
                                                background: P.raised;
                                                kt := Text {
                                                    text: "✿ " + root.hero.kicker;
                                                    font-size: 10.5px;
                                                    font-weight: 500;
                                                    letter-spacing: 1.5px;
                                                    color: P.accent-text;
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.hero.title;
                                            font-family: P.serif;
                                            font-weight: P.kawaii ? 900 : 700;
                                            font-size: root.tight ? 24px : (root.short ? 32px : (P.kawaii ? 36px : 40px));
                                            overflow: elide;
                                            color: P.text;
                                            PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
                                        }
                                        Text { text: root.hero.sub; font-size: 15px; color: P.text; overflow: elide; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                                        Text { text: root.hero.meta; font-size: 12.5px; color: P.muted; overflow: elide; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                                        // An album's stars, and the favorite toggle.
                                        if root.hero.rating >= 0 || root.hero.fav >= 0: HorizontalLayout {
                                            spacing: 2px;
                                            alignment: start;
                                            if root.hero.rating >= 0: HorizontalLayout {
                                                spacing: 0px;
                                                for n in [1, 2, 3, 4, 5]: Text {
                                                    width: 20px;
                                                    text: n <= root.hero.rating ? "★" : "☆";
                                                    font-size: 17px;
                                                    color: n <= root.hero.rating ? P.copper : (hsa.has-hover ? P.copper-dim : P.wave);
                                                    hsa := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.hero-rate(n == root.hero.rating ? 0 : n); keys.focus(); }
                                                    }
                                                }
                                            }
                                            if root.hero.rating >= 0 && root.hero.fav >= 0: Rectangle { width: 12px; }
                                            if root.hero.fav >= 0: Chip {
                                                h: 26px;
                                                text: root.tiny ? (root.hero.fav == 1 ? "★" : "☆") : (root.hero.fav == 1 ? "★ In Favorites" : "☆ Add to Favorites");
                                                peek: root.hero.fav == 1 ? "In Favorites" : "Add to Favorites";
                                                active: root.hero.fav == 1;
                                                clicked => { root.hero-fav(); keys.focus(); }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-top: root.short ? 6px : 12px;
                                            padding-bottom: P.kawaii ? 3px : 0px;
                                            HScroll {
                                            spacing: root.tight ? 6px : 8px;
                                            for a[i] in root.actions: Chip {
                                                h: root.tight ? 32px : (P.kawaii ? 36px : 40px);
                                                text: root.action-labels[i];
                                                primary: i == 0;
                                                icon-only: (root.compact && i > 1) || (root.tight && i > 0) || root.tiny;
                                                icon: a == "play" ? Icons.play : (a == "shuffle" ? Icons.shuffle : (a == "queue" ? Icons.plus : (a == "playlist" ? (P.kawaii ? Icons.heart : Icons.playlists) : "")));
                                                clicked => { root.view-action(a); keys.focus(); }
                                            }
                                            }
                                        }
                                    }
                                }
                            }

                            // Title row for everything else.
                            if !root.hero.show: HorizontalLayout {
                                padding-bottom: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 2px;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    if root.crumbs.length > 1: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for c[i] in root.crumbs: HorizontalLayout {
                                            spacing: 6px;
                                            if i > 0: Text { text: "›"; color: P.wave; font-size: 12px; }
                                            Text {
                                                text: c;
                                                overflow: elide;
                                                font-size: 12px;
                                                color: i == root.crumbs.length - 1 ? P.text : (cta.has-hover ? P.text : P.muted);
                                                cta := PeekArea {
                                                    mouse-cursor: i < root.crumbs.length - 1 ? pointer : default;
                                                    full: c;
                                                    cut: parent.preferred-width > parent.width + 0.5px;
                                                    tapped => { root.crumb-clicked(i); keys.focus(); }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.view-title;
                                        font-family: P.serif;
                                        font-weight: P.kawaii ? 900 : 700;
                                        font-size: 28px;
                                        color: P.text;
                                        overflow: elide;
                                        PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
                                    }
                                    Text { text: root.view-sub; font-size: 12.5px; color: P.muted; overflow: elide; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                                }
                                if !root.tight: HScroll {
                                    horizontal-stretch: 1;
                                    y: parent.height - self.height;
                                    align: end;
                                    for a[i] in root.actions: Chip {
                                        text: root.action-labels[i];
                                        icon: a == "new" || a == "subscribe" || a == "queue" ? Icons.plus : (a == "play" ? Icons.play : (a == "shuffle" ? Icons.shuffle : (a == "playlist" ? (P.kawaii ? Icons.heart : Icons.playlists) : "")));
                                        icon-only: root.compact && (a == "queue" || a == "playlist");
                                        primary: a == "play";
                                        clicked => { root.view-action(a); keys.focus(); }
                                    }
                                }
                            }
                            // Tight window: the buttons go under the title.
                            if !root.hero.show && root.tight && root.actions.length > 0: HorizontalLayout {
                                padding-bottom: 12px;
                                HScroll {
                                spacing: 6px;
                                for a[i] in root.actions: Chip {
                                    text: root.action-labels[i];
                                    icon: a == "new" || a == "subscribe" || a == "queue" ? Icons.plus : (a == "play" ? Icons.play : (a == "shuffle" ? Icons.shuffle : (a == "playlist" ? (P.kawaii ? Icons.heart : Icons.playlists) : "")));
                                    icon-only: root.tiny && (a == "queue" || a == "playlist" || a == "shuffle");
                                    primary: a == "play";
                                    clicked => { root.view-action(a); keys.focus(); }
                                }
                                }
                            }

                            // On a touch screen the EQ is drawn over this spot
                            // (below, after the list), not inside the scrolling
                            // page: the page would take every drag up or down,
                            // and the bands drag up and down.
                            eq-spot := Rectangle {
                                height: root.eq-panel && Ui.touch ? 280px : 0px;
                            }
                            if root.eq-panel && !Ui.touch: EqPanel {
                                height: 280px;
                                curve: root.eq-curve;
                                bands: root.eq-bands;
                                range: root.eq-range;
                                on: root.eq-on;
                                graphic: root.eq-graphic;
                                info: root.eq-info;
                                point(i, x, g) => { root.eq-point(i, x, g); }
                                act(a) => { root.view-action(a); keys.focus(); }
                            }
                            if root.eq-panel: Rectangle { height: 12px; }
                            if root.amp-panel: AmpPanel {
                                compact: Ui.touch || root.tight;
                                units: root.amp-units;
                                on: root.amp-on;
                                info: root.amp-info;
                                knob(i, j, p) => { root.amp-knob(i, j, p); }
                                step(i, j) => { root.amp-step(i, j); }
                                unit-toggle(i) => { root.amp-unit-toggle(i); }
                                act(a) => { root.view-action(a); keys.focus(); }
                            }
                            if root.amp-panel: Rectangle { height: 12px; }

                            // Column header.
                            if root.columns.length > 0: Rectangle {
                                height: 30px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: P.border; }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Text { width: 32px; text: root.columns[0]; horizontal-alignment: right; vertical-alignment: center; font-size: 11.5px; color: P.muted; }
                                    if root.covers: Rectangle { width: 30px; }
                                    Text { horizontal-stretch: 4; preferred-width: 0px; min-width: 60px; text: root.columns[1]; vertical-alignment: center; font-size: 11.5px; color: P.muted; }
                                    if root.columns[2] != "": Text { horizontal-stretch: 2.5; preferred-width: 0px; min-width: 40px; text: root.columns[2]; vertical-alignment: center; font-size: 11.5px; color: P.muted; }
                                    if root.columns[3] != "" && root.list-w >= 560px: Text { horizontal-stretch: 2.5; preferred-width: 0px; min-width: 60px; text: root.columns[3]; vertical-alignment: center; font-size: 11.5px; color: P.muted; }
                                    Text { min-width: root.list-w < 400px ? 44px : 64px; text: root.columns[4]; horizontal-alignment: right; vertical-alignment: center; font-size: 11.5px; color: P.muted; }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                // When the view is short, this much list stays,
                                // and the view around it scrolls instead.
                                // Under a tall panel on a phone (the Amp rack)
                                // the list takes its whole height instead, so
                                // the page scrolls as one. Otherwise the page
                                // takes every drag the moment it can move at
                                // all, and the rows in a short list under it
                                // can't be reached.
                                min-height: root.page-scroll ? max(180px, root.rows-height + 8px) : 180px;
                                list := ListView {
                                    for r[i] in root.layout == 0 ? root.rows : []: ListRow {
                                        item: r;
                                        selected: i == root.selected;
                                        focused: keys.has-focus;
                                        album-tracks: root.album-tracks;
                                        hearted: root.hearted-open;
                                        select => { root.row-select(i); keys.focus(); }
                                        activate => { root.row-activate(i); }
                                        act(a) => { root.row-select(i); root.row-act(i, a); }
                                    }
                                }
                                if root.rows.length == 0: Text {
                                    y: 24px;
                                    text: root.empty-text;
                                    color: P.muted;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    width: min(parent.width - 40px, 520px);
                                }
                            }
                        }
                        }

                        // The EQ on a touch screen, over its spot in the page and
                        // moving with it. Out of the page, so a drag on it moves
                        // the bands, not the page.
                        if root.eq-panel && Ui.touch && root.layout == 0: EqPanel {
                            x: lv.x + eq-spot.x;
                            y: body.content-y + eq-spot.y;
                            width: eq-spot.width;
                            height: eq-spot.height;
                            curve: root.eq-curve;
                            bands: root.eq-bands;
                            range: root.eq-range;
                            on: root.eq-on;
                            graphic: root.eq-graphic;
                            info: root.eq-info;
                            point(i, x, g) => { root.eq-point(i, x, g); }
                            act(a) => { root.view-action(a); keys.focus(); }
                        }

                        // Album grid.
                        Rectangle {
                        visible: root.layout == 1;
                        VerticalLayout {
                            padding-left: root.tight ? 8px : 24px;
                            padding-right: root.tight ? 8px : 24px;
                            padding-top: root.short ? 12px : 20px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 2px;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    if root.crumbs.length > 1: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for c[i] in root.crumbs: HorizontalLayout {
                                            spacing: 6px;
                                            if i > 0: Text { text: "›"; color: P.wave; font-size: 12px; }
                                            Text {
                                                text: c;
                                                overflow: elide;
                                                font-size: 12px;
                                                color: i == root.crumbs.length - 1 ? P.text : (gta.has-hover ? P.text : P.muted);
                                                gta := PeekArea {
                                                    mouse-cursor: i < root.crumbs.length - 1 ? pointer : default;
                                                    full: c;
                                                    cut: parent.preferred-width > parent.width + 0.5px;
                                                    tapped => { root.crumb-clicked(i); keys.focus(); }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.view-title;
                                        font-family: P.serif;
                                        font-weight: P.kawaii ? 900 : 700;
                                        font-size: 28px;
                                        color: P.text;
                                        overflow: elide;
                                        PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
                                    }
                                    Text { text: root.view-sub; font-size: 12.5px; color: P.muted; overflow: elide; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                                }
                                if !root.tight: HScroll {
                                    horizontal-stretch: 1;
                                    y: parent.height - self.height;
                                    align: end;
                                    for a[i] in root.actions: Chip {
                                        text: root.action-labels[i];
                                        icon: a == "queue" ? Icons.plus : (a == "play" ? Icons.play : (a == "shuffle" ? Icons.shuffle : (a == "playlist" ? (P.kawaii ? Icons.heart : Icons.playlists) : "")));
                                        icon-only: root.compact && (a == "queue" || a == "playlist");
                                        primary: a == "play";
                                        clicked => { root.view-action(a); keys.focus(); }
                                    }
                                }
                            }
                            if root.tight && root.actions.length > 0: HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 12px;
                                HScroll {
                                spacing: 6px;
                                for a[i] in root.actions: Chip {
                                    text: root.action-labels[i];
                                    icon: a == "queue" ? Icons.plus : (a == "play" ? Icons.play : (a == "shuffle" ? Icons.shuffle : (a == "playlist" ? (P.kawaii ? Icons.heart : Icons.playlists) : "")));
                                    icon-only: root.tiny && (a == "queue" || a == "playlist" || a == "shuffle");
                                    primary: a == "play";
                                    clicked => { root.view-action(a); keys.focus(); }
                                }
                                }
                            }
                            grid := Flickable {
                                vertical-stretch: 1;
                                property <int> cols: max(root.tiny ? 2 : 1, floor(self.width / 188px));
                                property <length> cell: self.width / cols;
                                content-height: ceil(root.rows.length / cols) * (cell + 44px);
                                for r[i] in root.layout == 1 ? root.rows : []: AlbumTile {
                                    x: mod(i, grid.cols) * grid.cell;
                                    y: floor(i / grid.cols) * (grid.cell + 44px);
                                    width: grid.cell;
                                    height: grid.cell + 44px;
                                    item: r;
                                    selected: i == root.selected;
                                    select => { root.row-select(i); keys.focus(); }
                                    activate => { root.row-activate(i); }
                                    act(a) => { root.row-select(i); root.row-act(i, a); }
                                }
                            }
                        }
                        }

                        // Queue as the main view.
                        Rectangle {
                        visible: root.layout == 2;
                        VerticalLayout {
                            padding-left: root.pad;
                            padding-right: root.pad;
                            padding-top: root.short ? 12px : 20px;
                            HorizontalLayout {
                                padding-bottom: root.tight ? 10px : 18px;
                                spacing: 8px;
                                VerticalLayout {
                                    Text { text: "Queue"; font-family: P.serif; font-weight: P.kawaii ? 900 : 700; font-size: 28px; color: P.text; }
                                    Text { text: root.queue-summary; font-size: 12.5px; color: P.muted; overflow: elide; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if !root.tight: HorizontalLayout {
                                    spacing: 8px;
                                    for srv in root.queue-servers: Chip {
                                        y: parent.height - self.height;
                                        text: "Queue from " + srv;
                                        clicked => { root.queue-load(srv); keys.focus(); }
                                    }
                                    if root.queue-mix-unsaved: Chip { y: parent.height - self.height; text: "Save mix"; clicked => { root.view-action("save-mix"); keys.focus(); } }
                                    Chip { y: parent.height - self.height; text: "Add to playlist"; clicked => { root.queue-save(); } }
                                    Chip { y: parent.height - self.height; text: "Clear"; danger: true; clicked => { root.queue-clear(); } }
                                }
                            }
                            if root.tight: HorizontalLayout {
                                padding-bottom: 12px;
                                spacing: 6px;
                                alignment: start;
                                for srv in root.queue-servers: Chip { text: "From " + srv; clicked => { root.queue-load(srv); keys.focus(); } }
                                if root.queue-mix-unsaved: Chip { text: "Save mix"; clicked => { root.view-action("save-mix"); keys.focus(); } }
                                Chip { text: "To playlist"; clicked => { root.queue-save(); } }
                                Chip { text: "Clear"; danger: true; clicked => { root.queue-clear(); } }
                            }
                            qlist := ListView {
                                vertical-stretch: 1;
                                for q[i] in root.queue: QueueLine {
                                    q: q;
                                    n: i + 1;
                                    selected: i == root.queue-sel;
                                    select => { root.queue-select(i); keys.focus(); }
                                    activate => { root.queue-activate(i); }
                                    act(a) => { root.queue-act(i, a); }
                                }
                            }
                            if root.queue.length == 0: Text {
                                text: "The queue is empty. Play something, or add it with Add to queue." + (P.kawaii ? "  (｡•‿•｡)" : "");
                                color: P.muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        }
                    }
                }

                Rectangle { width: root.lyrics-open ? root.lyrics-w : 0px; }
                Rectangle { width: root.queue-panel ? root.queue-w : 0px; }
            }

            // ----- Bottom bar -----
            // Placed by hand rather than by a layout, so it can switch
            // between one row (now playing, transport, controls) and two
            // rows (now playing and controls, then the transport across the
            // whole width). Nothing in it may overlap: a row that's short of
            // room first leaves out the badges, then goes to two rows.
            bar := Rectangle {
                height: root.bar-h;
                background: P.surface;
                property <length> bp: root.tight ? 12px : 20px;
                property <length> gap: root.tight ? 10px : 20px;
                // The least the now-playing side and the transport get.
                // The transport's five buttons are 212px.
                property <length> np-min: 160px;
                property <length> t-min: 220px;
                // The controls that always stay: lyrics, queue, mute and
                // the volume slider.
                property <length> keep-w: Ui.touch ? 3 * 36px + 40px + 3 * 8px : 3 * 36px + 96px + 40px + 4 * 8px;
                // One row, short of room for the badges: leave out the ones
                // that are only status, or open what the sidebar opens too.
                // Measured on the badges as they'd be (the probe below),
                // since what's on screen is what this decides.
                out property <bool> lean: !root.tight && self.width < 2 * bp + np-min + 2 * gap + t-min + keep-w + probe.preferred-width + 8px;
                // Two rows on a tight window, or when one row still won't
                // fit what's left.
                out property <bool> two-row: root.tight || self.width < 2 * bp + np-min + 2 * gap + t-min + rgt.preferred-width;
                // Controls on the right: as wide as they need, within reason.
                property <length> rw: min(rgt.preferred-width, self.width * 0.6);
                // One row: the transport sits in the middle where it fits,
                // and moves right of center when the now-playing side needs room.
                // two-row makes sure np-min and t-min always fit.
                property <length> tw: max(t-min, min(clamp(self.width * 0.42, 300px, 560px), self.width - 2 * bp - 2 * gap - rw - np-min));
                property <length> tx: max(bp + np-min + gap, min((self.width - tw) / 2, self.width - bp - rw - gap - tw));
                property <length> row-h: two-row ? 66px : self.height;
                Rectangle { height: 1px; y: 0; background: P.border; }

                // Never shown: the badges a lean bar leaves out, laid out
                // as they would be, for their width.
                probe := HorizontalLayout {
                    visible: false;
                    spacing: 8px;
                    if root.speed-label != "": Badge { text: root.speed-label; }
                    if root.bp-badge != "": Badge { text: root.bp-badge; }
                    Badge { text: "LIM -00.0 dB"; }
                    Badge { text: "EQ"; }
                    Badge { text: "AMP"; }
                    if root.level-label != "": Badge { text: root.level-label; }
                }

                    // Now playing.
                    np := HorizontalLayout {
                        x: bar.bp;
                        y: 0;
                        width: bar.two-row ? bar.width - 2 * bar.bp - bar.gap - bar.rw : bar.tx - bar.gap - bar.bp;
                        height: bar.row-h;
                        spacing: bar.two-row ? 10px : 12px;
                        Cover {
                            width: bar.two-row ? 44px : 56px;
                            height: bar.two-row ? 44px : 56px;
                            y: (parent.height - self.height) / 2;
                            art: root.np-art;
                            has-art: root.np-has-art;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.has-track ? root.np-title : "Nothing playing";
                                overflow: elide;
                                font-weight: 600;
                                color: root.has-track ? P.text : P.muted;
                                PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
                            }
                            Text { text: root.np-sub; overflow: elide; font-size: 12px; color: P.muted; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                            if root.status-line != "": Text {
                                text: root.status-line;
                                overflow: elide;
                                font-size: 11.5px;
                                color: root.status-warn ? P.copper : P.verdigris;
                                PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; }
                            }
                        }
                        if root.love-state > 0: IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.heart;
                            tip: root.love-state == 2 ? "Hearted (l)" : "Heart (l)";
                            // Filled in when the song playing is hearted.
                            filled: root.love-state == 2;
                            active: root.love-state == 2;
                            clicked => { root.love-clicked(); keys.focus(); }
                        }
                        // Stars for the song playing; click one to rate,
                        // the same one again to clear.
                        // Only where the title still has room beside them.
                        if root.np-rating >= 0 && !root.compact && np.width >= 400px: HorizontalLayout {
                            spacing: 0px;
                            for n in [1, 2, 3, 4, 5]: Text {
                                width: 15px;
                                text: n <= root.np-rating ? "★" : "☆";
                                font-size: 13px;
                                vertical-alignment: center;
                                color: n <= root.np-rating ? P.copper : (nsa.has-hover ? P.copper-dim : P.wave);
                                nsa := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.np-rate(n == root.np-rating ? 0 : n); keys.focus(); }
                                }
                            }
                        }
                    }

                    // Transport and seek.
                    VerticalLayout {
                        x: bar.two-row ? bar.bp : bar.tx;
                        y: bar.two-row ? bar.row-h - 6px : 0px;
                        width: bar.two-row ? bar.width - 2 * bar.bp : bar.tw;
                        height: bar.two-row ? bar.height - bar.row-h + 6px : bar.height;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            IconButton { icon: Icons.shuffle; tip: "Shuffle"; active: root.shuffle; clicked => { root.toggle-shuffle(); keys.focus(); } }
                            IconButton { icon: Icons.prev; filled: true; icon-size: 20px; tip: "Back"; clicked => { root.prev(); keys.focus(); } }
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: pp.has-hover ? P.accent-hover : P.verdigris;
                                drop-shadow-offset-y: P.kawaii ? 3px : 0px;
                                drop-shadow-color: P.kawaii ? P.accent-edge : transparent;
                                accessible-role: button;
                                accessible-label: root.playing ? "Pause" : "Play";
                                // Two bars as rectangles: a two-shape path draws its
                                // gap filled in.
                                if root.playing: Rectangle {
                                    x: 15px;
                                    y: 14px;
                                    width: 5px;
                                    height: 16px;
                                    border-radius: 1px;
                                    background: P.on-accent;
                                }
                                if root.playing: Rectangle {
                                    x: 24px;
                                    y: 14px;
                                    width: 5px;
                                    height: 16px;
                                    border-radius: 1px;
                                    background: P.on-accent;
                                }
                                if !root.playing: FilledIcon {
                                    x: (parent.width - self.width) / 2 + 1px;
                                    y: (parent.height - self.height) / 2;
                                    d: Icons.play;
                                    size: 18px;
                                    fill: P.on-accent;
                                }
                                pp := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.play-pause(); keys.focus(); }
                                }
                            }
                            IconButton { icon: Icons.next; filled: true; icon-size: 20px; tip: "Next"; clicked => { root.next(); keys.focus(); } }
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                IconButton {
                                    icon: Icons.repeat;
                                    tip: root.repeat == 0 ? "Repeat off" : (root.repeat == 1 ? "Repeat all" : "Repeat one");
                                    active: root.repeat != 0;
                                    clicked => { root.cycle-repeat(); keys.focus(); }
                                }
                                if root.repeat == 2: Text {
                                    x: 24px;
                                    y: 4px;
                                    text: "1";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: P.verdigris;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                width: 52px;
                                text: root.elapsed;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                font-family: P.mono;
                                font-size: 11.5px;
                                color: P.muted;
                            }
                            if !root.live: Bar {
                                horizontal-stretch: 1;
                                label: "Seek";
                                value: root.position;
                                enabled: root.has-track;
                                changed(v) => { root.seek(v); keys.focus(); }
                            }
                            if root.live: Text {
                                horizontal-stretch: 1;
                                text: "live";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 12px;
                                color: P.verdigris;
                            }
                            Text {
                                width: 52px;
                                text: root.remaining;
                                vertical-alignment: center;
                                font-family: P.mono;
                                font-size: 11.5px;
                                color: P.muted;
                            }
                        }
                    }

                    // Badges, output, queue toggle, volume.
                    rgt := HorizontalLayout {
                        x: bar.width - bar.bp - bar.rw;
                        y: 0;
                        width: bar.rw;
                        height: bar.row-h;
                        alignment: end;
                        spacing: root.tiny ? 4px : 8px;
                        if root.speed-label != "" && !root.tight: Rectangle {
                            width: sp.preferred-width + 16px;
                            height: 22px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: root.speed-label == "1.0x" ? P.border : P.copper-dim;
                            sp := Text {
                                text: root.speed-label;
                                font-family: P.mono;
                                font-size: 11px;
                                color: root.speed-label == "1.0x" ? P.muted : P.copper;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.speed-clicked(); } }
                        }
                        // Click it to hear why (or what device, and how).
                        if root.bp-badge != "" && !root.tiny && !bar.lean: Rectangle {
                            width: bpb.width;
                            bpb := Badge {
                                y: (parent.height - self.height) / 2;
                                text: root.bp-badge;
                                fg: root.bp-tone == 0 ? (P.kawaii ? P.mint : P.verdigris) : (root.bp-tone == 2 ? P.copper : P.muted);
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.bp-clicked(); }
                            }
                        }
                        // The limiter: always here, at the width of its
                        // longest reading, so nothing beside it moves when
                        // it starts or stops. Lit copper, with how much it's
                        // taking off, while it works.
                        if !root.tiny && !root.tight && !bar.lean: Rectangle {
                            width: limw.preferred-width + 16px;
                            limw := Text {
                                visible: false;
                                text: "LIM -00.0 dB";
                                font-family: P.mono;
                                font-size: 11px;
                            }
                            Badge {
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                text: root.limit-label != "" ? root.limit-label : "LIM";
                                fg: root.limit-label != "" ? P.copper : P.wave;
                            }
                        }
                        // The EQ: lit when it's on and shaping the sound.
                        // Click it for the EQ view.
                        if !root.tiny && !bar.lean: Rectangle {
                            width: eqb.width;
                            eqb := Badge {
                                y: (parent.height - self.height) / 2;
                                text: "EQ";
                                fg: root.eq-lit ? (P.kawaii ? P.mint : P.verdigris) : P.wave;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.eq-chip(); }
                            }
                        }
                        // The amp stack: lit copper when it's working.
                        if !root.tiny && !bar.lean: Rectangle {
                            width: ampb.width;
                            ampb := Badge {
                                y: (parent.height - self.height) / 2;
                                text: "AMP";
                                fg: root.amp-lit ? P.copper : P.wave;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.amp-chip(); }
                            }
                        }
                        // Click it for where the gain came from.
                        if root.level-label != "" && !root.tight && !bar.lean: Rectangle {
                            width: lvb.width;
                            lvb := Badge {
                                y: (parent.height - self.height) / 2;
                                text: root.level-label;
                                fg: P.muted;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.level-clicked(); }
                            }
                        }
                        if root.badge != "" && !root.compact: Badge {
                            y: (parent.height - self.height) / 2;
                            text: root.badge;
                        }
                        if root.resample-label != "" && !root.compact: Badge {
                            y: (parent.height - self.height) / 2;
                            text: root.resample-label;
                            fg: P.copper;
                        }
                        if root.output-label != "" && !root.compact: Chip {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.output;
                            text: root.output-label;
                            clicked => { root.output-clicked(); }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.lyrics;
                            tip: "Lyrics (Ctrl+L)";
                            active: root.lyrics-open;
                            clicked => { root.lyrics-clicked(); keys.focus(); }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.queue-panel;
                            tip: "Queue panel";
                            active: root.queue-panel;
                            clicked => { root.toggle-queue(); keys.focus(); }
                        }
                        // Desktop: the button mutes and the slider sits beside
                        // it. Touch: the button opens a tall slider, since a
                        // short sideways one is too fiddly for a finger.
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.muted ? Icons.muted : Icons.volume;
                            tip: Ui.touch ? "Volume" : (root.muted ? "Unmute" : "Mute");
                            active: Ui.touch ? root.volume-open : root.muted;
                            clicked => {
                                if Ui.touch {
                                    root.volume-open = !root.volume-open;
                                } else {
                                    root.toggle-mute();
                                }
                                keys.focus();
                            }
                        }
                        if !Ui.touch: Bar {
                            width: root.tiny ? 64px : (root.tight ? 80px : 96px);
                            y: (parent.height - self.height) / 2;
                            label: root.volume-locked ? "Volume, fixed at 100% for bit-perfect" : "Volume";
                            value: root.volume-locked ? 1.0 : root.volume;
                            enabled: !root.volume-locked;
                            fill: root.muted ? P.wave : (P.kawaii ? P.mint : P.verdigris);
                            knob: 12px;
                            live: true;
                            changed(v) => { root.set-volume(v); }
                        }
                        Rectangle {
                            width: 40px;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.volume-pct;
                                horizontal-alignment: Ui.touch ? left : right;
                                vertical-alignment: center;
                                font-family: P.mono;
                                font-size: 11.5px;
                                color: root.muted ? P.wave : P.muted;
                            }
                            if Ui.touch: TouchArea {
                                clicked => { root.volume-open = !root.volume-open; keys.focus(); }
                            }
                        }
                    }
            }
        }

        // Tiny window: the sidebar is a drawer over the view, with a scrim
        // behind it that closes it.
        if root.drawer && root.drawer-open: Rectangle {
            y: 0;
            height: keys.height - root.bar-h;
            background: P.scrim;
            TouchArea { clicked => { root.drawer-open = false; keys.focus(); } }
        }

        // ----- Sidebar -----
        sidebar := Rectangle {
            // Folded to icons on a narrow window, or by choice.
            property <bool> folded: root.side-folded && !root.drawer;
            x: 0;
            y: 0;
            width: root.drawer ? 228px : root.side-w;
            height: keys.height - root.bar-h;
            visible: !root.drawer || root.drawer-open;
            background: P.surface;
            drop-shadow-blur: root.drawer ? 18px : 0px;
            drop-shadow-color: P.shadow;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: P.border;
            }
            VerticalLayout {
                padding: sidebar.folded ? 8px : 12px;
                padding-top: 16px;
                spacing: 2px;
                if sidebar.folded: Text {
                    height: 38px;
                    text: "P";
                    horizontal-alignment: center;
                    font-family: P.serif;
                    font-weight: P.kawaii ? 900 : 700;
                    font-size: 22px;
                    color: P.accent-text;
                }
                if !sidebar.folded: VerticalLayout {
                    padding-left: 10px;
                    padding-bottom: P.kawaii ? 10px : 14px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: "Patina";
                            font-family: P.serif;
                            font-weight: P.kawaii ? 900 : 700;
                            font-size: P.kawaii ? 22px : 20px;
                            color: P.text;
                        }
                        Text {
                            text: "Player";
                            font-family: P.serif;
                            font-weight: P.kawaii ? 900 : 700;
                            font-size: P.kawaii ? 22px : 20px;
                            color: P.accent-text;
                        }
                        if P.kawaii: Rectangle {
                            width: 26px;
                            Icon {
                                x: 6px;
                                y: (parent.height - self.height) / 2 + 1px;
                                d: Icons.heart;
                                size: 18px;
                                stroke: P.verdigris;
                                stroke-width: 2px;
                            }
                        }
                        Rectangle {}
                    }
                    if P.kawaii: Text {
                        text: P.light ? "おんがく の じかん" : "よる の おんがく";
                        font-size: 10.5px;
                        letter-spacing: 2px;
                        color: P.muted;
                    }
                }
                Flickable {
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for item[i] in root.side: Rectangle {
                            // Kawaii: the open one is a pink pill.
                            property <bool> pill: item.active && P.kawaii && item.kind == 0;
                            // Favorites sit like sections, with a menu.
                            property <bool> entry: item.kind <= 1 || item.kind == 4;
                            height: item.kind == 3 ? 12px : (item.kind == 2 ? 28px : 34px);
                            border-radius: 6px * P.round;
                            border-width: 1px;
                            border-color: pill ? P.verdigris : (item.active ? P.verdigris-dim : transparent);
                            background: pill ? P.verdigris : (item.active ? P.raised : (sta.has-hover && entry ? P.raised : transparent));
                            drop-shadow-offset-y: pill ? 3px : 0px;
                            drop-shadow-color: pill ? P.accent-edge : transparent;
                            if item.kind == 2 && sidebar.folded: Rectangle {
                                x: 8px;
                                y: parent.height - 8px;
                                width: parent.width - 16px;
                                height: 1px;
                                background: P.border;
                            }
                            if item.kind == 2 && !sidebar.folded: Text {
                                x: 10px;
                                y: parent.height - self.height - 4px;
                                text: item.sub != "" ? item.label + "  ·  " + item.sub : item.label;
                                font-size: 11px;
                                letter-spacing: 0.9px;
                                color: P.muted;
                            }
                            if entry: HorizontalLayout {
                                padding-left: sidebar.folded ? (item.kind == 0 && P.kawaii ? 12px : 16px) : 10px;
                                padding-right: sidebar.folded ? 0px : 10px;
                                spacing: 10px;
                                if item.kind == 0 && !P.kawaii: Rectangle {
                                    width: 16px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        d: item.icon;
                                        stroke: item.active ? P.verdigris : (sta.has-hover ? P.text : P.muted);
                                    }
                                }
                                // Kawaii: the icon sits in a round bubble.
                                if item.kind == 0 && P.kawaii: Rectangle {
                                    width: 24px;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: pill ? P.on-accent : P.raised;
                                        Icon {
                                            x: 5px;
                                            y: 5px;
                                            size: 14px;
                                            d: item.icon;
                                            stroke: P.verdigris;
                                            stroke-width: 2px;
                                        }
                                    }
                                }
                                if item.kind == 4: Rectangle {
                                    width: 16px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        d: Icons.star;
                                        stroke: P.copper;
                                    }
                                }
                                if item.kind == 1: Rectangle {
                                    width: 16px;
                                    Rectangle {
                                        x: 4px;
                                        y: (parent.height - self.height) / 2;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: item.dot == 0 ? (P.kawaii ? P.mint : P.verdigris) : (item.dot == 1 ? P.verdigris-dim : (item.dot == 2 ? P.copper : P.muted));
                                    }
                                }
                                if item.sub == "" && !sidebar.folded: Text {
                                    text: item.label;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-size: 13px;
                                    font-weight: P.kawaii ? 500 : 400;
                                    color: pill ? P.on-accent : (item.active ? P.accent-text : (sta.has-hover || P.kawaii ? P.text : P.muted));
                                    init => { label-cut = self.preferred-width > self.width + 0.5px; }
                                    changed width => { label-cut = self.preferred-width > self.width + 0.5px; }
                                    changed text => { label-cut = self.preferred-width > self.width + 0.5px; }
                                }
                                // The Japanese name follows on the same line, small,
                                // so the sidebar keeps its height.
                                if item.sub != "" && !sidebar.folded: HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;
                                    Text {
                                        text: item.label;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: pill ? P.on-accent : P.text;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.sub;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        font-size: 9.5px;
                                        color: pill ? P.on-accent : P.muted;
                                        init => { label-cut = self.preferred-width > self.width + 0.5px; }
                                        changed width => { label-cut = self.preferred-width > self.width + 0.5px; }
                                        changed text => { label-cut = self.preferred-width > self.width + 0.5px; }
                                    }
                                }
                                if !sidebar.folded: Text {
                                    text: item.count;
                                    vertical-alignment: center;
                                    font-family: P.mono;
                                    font-size: 11px;
                                    color: pill ? P.on-accent : (item.dot == 2 ? P.copper : P.muted);
                                }
                            }
                            property <bool> long-fired;
                            // The name doesn't fit beside its icon and count.
                            property <bool> label-cut;
                            property <string> label-full: item.sub != "" ? item.label + "  " + item.sub : item.label;
                            property <bool> side-peeks: item.kind != 4 && label-cut && !sidebar.folded;
                            scm := ContextMenuArea {
                                enabled: item.kind == 4;
                                Menu {
                                    if label-cut: MenuItem { title: label-full; enabled: false; }
                                    if label-cut: MenuSeparator {}
                                    MenuItem { title: "Move up"; activated => { root.side-act(i, "up"); } }
                                    MenuItem { title: "Move down"; activated => { root.side-act(i, "down"); } }
                                    MenuItem { title: "Remove from Favorites"; activated => { root.side-act(i, "remove"); } }
                                }
                                // Favorites: a long press opens their menu too.
                                shold := Timer {
                                    interval: LongPress.after;
                                    running: false;
                                    triggered => {
                                        self.running = false;
                                        if sta.pressed {
                                            long-fired = true;
                                            if item.kind == 4 {
                                                scm.show({ x: sta.mouse-x, y: sta.mouse-y });
                                            } else {
                                                Peek.show(label-full, sta.absolute-position.x + sta.mouse-x, sta.absolute-position.y + sta.mouse-y);
                                            }
                                        }
                                    }
                                }
                                sta := TouchArea {
                                    enabled: entry;
                                    mouse-cursor: entry ? pointer : default;
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down {
                                            long-fired = false;
                                            // Anything else whose name is cut short: the
                                            // whole name in a bubble.
                                            if e.button == PointerEventButton.right && item.kind == 4 {
                                                scm.show({ x: self.mouse-x, y: self.mouse-y });
                                            } else if e.button == PointerEventButton.right && side-peeks {
                                                Peek.show(label-full, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            } else if e.button == PointerEventButton.left && ((item.kind == 4 && Ui.touch) || side-peeks) {
                                                shold.running = false;
                                                shold.running = true;
                                            }
                                        }
                                        if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                            shold.running = false;
                                        }
                                    }
                                    changed has-hover => {
                                        if self.has-hover && sidebar.folded {
                                            root.side-tip = item.sub != "" ? item.label + "  " + item.sub : item.label;
                                            root.side-tip-y = self.absolute-position.y + (self.height - 26px) / 2;
                                        } else if !self.has-hover {
                                            root.side-tip = "";
                                        }
                                    }
                                    clicked => {
                                        if long-fired { return; }
                                        root.side-tip = "";
                                        root.drawer-open = false;
                                        root.side-clicked(i);
                                        keys.focus();
                                    }
                                }
                            }
                        }
                    }
                }
                // Fold to icons, or expand to names. It sticks for this
                // way of holding the screen (Settings has both).
                Rectangle {
                    height: 44px;
                    Rectangle { y: 0; height: 1px; background: P.border; }
                    HorizontalLayout {
                        padding-top: 8px;
                        alignment: sidebar.folded ? center : end;
                        IconButton {
                            icon: sidebar.folded ? Icons.forward : Icons.back;
                            tip: sidebar.folded ? "Expand the sidebar" : "Fold the sidebar to icons";
                            clicked => {
                                root.side-tip = "";
                                root.drawer-open = false;
                                root.side-fold(root.landscape, !sidebar.folded);
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }

        // The folded sidebar's label for the icon under the pointer.
        if root.side-tip != "" && sidebar.folded: Rectangle {
            x: root.side-w + 6px;
            y: root.side-tip-y;
            width: stt.preferred-width + 20px;
            height: 26px;
            border-radius: 6px * P.round;
            border-width: 1px;
            border-color: P.border;
            background: P.raised;
            drop-shadow-blur: 8px;
            drop-shadow-color: P.shadow;
            stt := Text { text: root.side-tip; font-size: 12px; color: P.text; }
        }

        // ----- Lyrics panel -----
        if root.lyrics-open: Rectangle {
            x: root.tiny ? 0px : keys.width - root.lyrics-w - (root.queue-panel ? root.queue-w : 0px);
            y: 0;
            width: root.tiny ? keys.width : root.lyrics-w;
            height: keys.height - root.bar-h;
            background: P.surface;
            // Nothing inside draws past the panel, however long the song.
            clip: true;
            // Takes the clicks, so none reach the view under it.
            TouchArea {}
            Rectangle { width: 1px; x: 0; background: P.border; }
            VerticalLayout {
                padding-top: 16px;
                padding-left: 18px;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "Lyrics"; font-family: P.serif; font-weight: P.kawaii ? 900 : 700; font-size: 17px; color: P.text; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: Icons.close; tip: "Close (Ctrl+L)"; clicked => { root.lyrics-clicked(); keys.focus(); } }
                }
                Text { text: root.lyrics-title; overflow: elide; font-weight: 600; color: P.text; PeekArea { full: parent.text; cut: parent.preferred-width > parent.width + 0.5px; } }
                Text { text: root.lyrics-note; wrap: word-wrap; font-size: 11.5px; color: root.lyrics-warn ? P.copper : P.muted; }
                Rectangle { height: 6px; }
                // Synced: the lines from a little before the one
                // playing, which the app picks, so it stays in view.
                // A Flickable rather than a plain box: a box takes its child
                // layout's height as its own minimum, which pushed the
                // panel's layout past the panel and the lines over the app.
                if root.lyrics-synced: Flickable {
                    vertical-stretch: 1;
                    interactive: false;
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        for l[i] in root.lyrics-lines: Text {
                            text: l;
                            wrap: word-wrap;
                            font-size: i == root.lyrics-current ? 15px : 13.5px;
                            font-weight: i == root.lyrics-current ? 700 : 400;
                            color: i == root.lyrics-current ? P.accent-text : (i < root.lyrics-current ? P.muted : P.text);
                        }
                    }
                }
                if !root.lyrics-synced: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        for l in root.lyrics-lines: Text {
                            text: l;
                            wrap: word-wrap;
                            font-size: 13.5px;
                            color: P.text;
                        }
                    }
                }
            }
        }

        // ----- Queue panel -----
        if root.queue-panel: Rectangle {
            x: root.tiny ? 0px : keys.width - root.queue-w;
            y: 0;
            width: root.tiny ? keys.width : root.queue-w;
            height: keys.height - root.bar-h;
            background: P.surface;
            TouchArea {}
            Rectangle { width: 1px; x: 0; background: P.border; }
            VerticalLayout {
                padding-top: 16px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 10px;
                    Text { text: "Queue"; font-family: P.serif; font-weight: P.kawaii ? 900 : 700; font-size: 17px; color: P.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.queue-summary; font-size: 11.5px; color: P.muted; vertical-alignment: center; }
                    if root.tiny: IconButton { icon: Icons.close; tip: "Close"; clicked => { root.toggle-queue(); keys.focus(); } }
                }
                // A ListView, so only the rows in view exist, however
                // long the queue gets.
                ListView {
                    vertical-stretch: 1;
                    content-y <=> root.panel-scroll;
                    for q[i] in root.queue: Rectangle {
                        height: 54px;
                        Rectangle {
                            x: 8px;
                            y: 1px;
                            width: parent.width - 16px;
                            height: 52px;
                            border-radius: 6px * P.round;
                            border-width: q.playing ? (P.kawaii ? 2px : 1px) : 0px;
                            border-color: P.kawaii ? P.verdigris : P.verdigris-dim;
                            background: q.playing ? P.playing-bg : (pta.has-hover ? P.raised : transparent);
                            HorizontalLayout {
                                padding: 7px;
                                spacing: 10px;
                                Cover { width: 36px; height: 36px; radius: 4px; art: q.art; has-art: q.has-art; }
                                VerticalLayout {
                                    alignment: center;
                                    qp-title := Text { text: q.title; overflow: elide; font-weight: q.playing ? 700 : 400; color: q.playing ? P.accent-text : P.text; }
                                    qp-sub := Text { text: q.sub; overflow: elide; font-size: 12px; color: P.muted; }
                                }
                            }
                            pta := PeekArea {
                                full: q.sub != "" ? q.title + "\n" + q.sub : q.title;
                                cut: qp-title.preferred-width > qp-title.width + 0.5px || qp-sub.preferred-width > qp-sub.width + 0.5px;
                                tapped => { root.queue-activate(i); }
                            }
                        }
                    }
                }
                if P.kawaii && root.queue.length > 0: Text {
                    height: 30px;
                    text: P.light ? "ゆっくり きいてね ♪  (っ˘ω˘ς )" : "☆ﾐ(o*･ω･)ﾉ  いい ゆめ を ♪";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 11.5px;
                    color: P.muted;
                }
                Rectangle {
                    height: 58px;
                    Rectangle { height: 1px; y: 0; background: P.border; }
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 16px;
                        spacing: 8px;
                        alignment: start;
                        Chip { text: "Add to playlist"; clicked => { root.queue-save(); } }
                        Chip { text: "Clear"; danger: true; clicked => { root.queue-clear(); } }
                    }
                }
            }
        }

        // ----- Volume popup (touch) -----
        // A tall slider over the bottom bar's right end. A tap anywhere
        // else, or Back, closes it.
        if root.volume-open && Ui.touch: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea { clicked => { root.volume-open = false; keys.focus(); } }
            Rectangle {
                width: 96px;
                height: min(340px, keys.height - root.bar-h - 24px);
                x: parent.width - self.width - 12px;
                y: parent.height - root.bar-h - self.height - 8px;
                border-radius: 12px * P.round;
                border-width: 1px;
                border-color: P.border;
                background: P.raised;
                drop-shadow-blur: 16px;
                drop-shadow-color: P.shadow;
                // Swallow presses on the panel itself, so they don't close it.
                TouchArea {}
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: root.volume-pct;
                        horizontal-alignment: center;
                        font-family: P.mono;
                        font-size: 18px;
                        color: root.muted ? P.muted : P.text;
                    }
                    VBar {
                        vertical-stretch: 1;
                        label: root.volume-locked ? "Volume, fixed at 100% for bit-perfect" : "Volume";
                        value: root.volume-locked ? 1.0 : root.volume;
                        enabled: !root.volume-locked;
                        fill: root.muted ? P.wave : (P.kawaii ? P.mint : P.verdigris);
                        changed(v) => { root.set-volume(v); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        IconButton {
                            width: 44px;
                            height: 44px;
                            icon-size: 20px;
                            icon: root.muted ? Icons.muted : Icons.volume;
                            tip: root.muted ? "Unmute" : "Mute";
                            active: root.muted;
                            enabled: !root.volume-locked;
                            clicked => { root.toggle-mute(); }
                        }
                    }
                }
            }
        }

        // ----- Toast -----
        if root.toast != "": Rectangle {
            x: parent.width - self.width - 24px;
            y: parent.height - root.bar-h - self.height - 16px;
            width: min(tt.preferred-width + 36px, 520px, keys.width - 48px);
            height: tt.preferred-height + 20px;
            border-radius: 8px * P.round;
            border-width: 1px;
            border-color: root.toast-error ? P.copper-dim : P.verdigris-dim;
            background: P.raised;
            drop-shadow-blur: 12px;
            drop-shadow-color: P.shadow;
            tt := Text {
                x: 18px;
                width: parent.width - 36px;
                text: root.toast;
                wrap: word-wrap;
                vertical-alignment: center;
                color: root.toast-error ? P.copper : P.text;
            }
        }

        // ----- Dialogs -----
        // Centred in the part of the screen the on-screen keyboard leaves
        // free, and no taller than that, so the field being typed in stays
        // in view.
        if root.dialog != 0 && !(root.dialog == 1 && root.native-text): Rectangle {
            property <length> kb-top: root.virtual-keyboard-size.height > 0
                ? clamp(root.virtual-keyboard-position.y - keys.y, 120px, keys.height)
                : keys.height;
            background: P.scrim;
            TouchArea { clicked => { root.dlg-cancel(); } }
            Rectangle {
                width: min(root.dialog == 4 ? 620px : 460px, keys.width - 24px);
                height: min(dlg.preferred-height, parent.kb-top - 24px);
                y: (parent.kb-top - self.height) / 2;
                clip: true;
                border-radius: 10px * P.round;
                border-width: 1px;
                border-color: P.border;
                background: P.surface;
                drop-shadow-blur: 24px;
                drop-shadow-color: P.shadow;
                TouchArea {}
                dlg := VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text {
                        text: root.dlg-title;
                        font-family: P.serif;
                        font-weight: P.kawaii ? 900 : 700;
                        font-size: 19px;
                        color: P.text;
                    }

                    if root.dialog == 1: VerticalLayout {
                        spacing: 12px;
                        f1 := Field {
                            autofocus: true;
                            label: root.dlg-label1;
                            text <=> root.dlg-text1;
                            accepted => {
                                if root.dlg-two-fields { f2.focus-field(); } else { root.dlg-accept(); }
                            }
                        }
                        f2 := Field {
                            visible: root.dlg-two-fields;
                            height: root.dlg-two-fields ? 58px : 0px;
                            label: root.dlg-label2;
                            text <=> root.dlg-text2;
                            accepted => {
                                if root.dlg-four-fields { f3.focus-field(); } else { root.dlg-accept(); }
                            }
                        }
                        f3 := Field {
                            visible: root.dlg-four-fields;
                            height: root.dlg-four-fields ? 58px : 0px;
                            label: root.dlg-label3;
                            text <=> root.dlg-text3;
                            accepted => { f4.focus-field(); }
                        }
                        f4 := Field {
                            visible: root.dlg-four-fields;
                            height: root.dlg-four-fields ? 58px : 0px;
                            secret: true;
                            label: root.dlg-label4;
                            text <=> root.dlg-text4;
                            accepted => { root.dlg-accept(); }
                        }
                    }

                    // Playlists to pick from. Scrolls once there are many.
                    if root.dialog == 2: ListView {
                        height: min(root.dlg-items.length * 38px, 380px, keys.height - 180px);
                        for it[i] in root.dlg-items: Rectangle {
                            height: 38px;
                            Rectangle {
                                y: 1px;
                                height: 36px;
                                border-radius: 6px * P.round;
                                background: dta.has-hover ? P.raised : transparent;
                                pick := Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    text: it;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    color: i == 0 && root.dlg-new-first ? P.accent-text : P.text;
                                }
                                dta := PeekArea {
                                    mouse-cursor: pointer;
                                    full: it;
                                    cut: pick.preferred-width > pick.width + 0.5px;
                                    tapped => { root.dlg-pick(i); }
                                }
                            }
                        }
                    }

                    if root.dialog == 3: Text {
                        text: root.dlg-message;
                        wrap: word-wrap;
                        color: P.text;
                    }

                    // The help is long; on a short window it scrolls.
                    if root.dialog == 4: Flickable {
                        height: min(ht.preferred-height, keys.height - 160px);
                        content-height: ht.preferred-height;
                        ht := Text {
                            width: parent.width;
                            text: root.dlg-message;
                            wrap: word-wrap;
                            font-family: P.mono;
                            font-size: 12px;
                            color: P.text;
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        padding-top: 4px;
                        Chip {
                            text: root.dialog == 4 ? "Close" : "Cancel";
                            h: 36px;
                            clicked => { root.dlg-cancel(); }
                        }
                        if root.dialog == 1 || root.dialog == 3: Chip {
                            text: root.dlg-ok;
                            h: 36px;
                            primary: root.dialog == 1;
                            danger: root.dialog == 3;
                            clicked => { root.dlg-accept(); }
                        }
                    }
                }
            }
        }

        // ----- A cut-short text, shown whole -----
        // Above everything, dialogs included. Any press outside the bubble
        // closes it and goes no further; a press on it closes it too.
        if Peek.open: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down { Peek.open = false; }
                }
                scroll-event(e) => {
                    Peek.open = false;
                    accept
                }
            }
            // The text at one line's width, to size the bubble by.
            peek-measure := Text {
                width: 0px;
                height: 0px;
                visible: false;
                text: Peek.text;
                font-size: 13px;
            }
            peek-bubble := Rectangle {
                property <length> pad: 12px;
                // Where the press was, in this overlay's coordinates.
                property <length> px: Peek.at-x - root.safe-area-insets.left;
                property <length> py: Peek.at-y - root.safe-area-insets.top;
                width: min(peek-measure.preferred-width + 2 * self.pad + 2px, 440px, parent.width - 16px);
                height: peek-text.preferred-height + 2 * self.pad - 4px;
                // Just under and right of the pointer; flipped above it, or
                // pulled in from the edge, where there's no room.
                x: max(8px, min(self.px + 4px, parent.width - self.width - 8px));
                y: self.py + 18px + self.height <= parent.height - 8px
                    ? self.py + 18px
                    : max(8px, self.py - self.height - 10px);
                border-radius: 8px * P.round;
                border-width: 1px;
                border-color: P.verdigris-dim;
                background: P.raised;
                drop-shadow-blur: 12px;
                drop-shadow-color: P.shadow;
                peek-text := Text {
                    x: peek-bubble.pad;
                    y: peek-bubble.pad - 2px;
                    width: peek-bubble.width - 2 * peek-bubble.pad;
                    text: Peek.text;
                    wrap: word-wrap;
                    font-size: 13px;
                    color: P.text;
                }
                accessible-role: text;
                accessible-label: Peek.text;
            }
        }
    }
}
