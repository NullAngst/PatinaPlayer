// PatinaPlayer desktop UI. Layout follows the design mockup: sidebar,
// header with back/forward and search, the open view, an optional queue
// panel, and the bottom bar. All state and every action lives in Rust
// (patina-core's Browser); this file only draws and forwards input.

import { ListView, ScrollView } from "std-widgets.slint";

import "fonts/Inter-Regular.otf";
import "fonts/Inter-Medium.otf";
import "fonts/Inter-SemiBold.otf";
import "fonts/Inter-Bold.otf";
import "fonts/NotoSerif-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/MPLUSRounded1c-Regular.ttf";
import "fonts/MPLUSRounded1c-Medium.ttf";
import "fonts/MPLUSRounded1c-Bold.ttf";
import "fonts/MPLUSRounded1c-ExtraBold.ttf";
import "fonts/ZenMaruGothic-Black.ttf";

// ----- Palette -----
//
// Six themes, picked in Settings: 0 Runout (dark verdigris and copper),
// 1 Kawaii Light (Sakura Milk: cream and strawberry pink), 2 Kawaii Dark
// (the same pink and butter on cocoa plum), 3 Light and 4 Dark (plain
// greys and one blue), 5 OLED (true black). The names are Runout's;
// `verdigris` is the main accent and `copper` the warm one in every theme.
struct Palette {
    bg: color,
    surface: color,
    raised: color,
    border: color,
    text: color,
    muted: color,
    verdigris: color,
    verdigris-dim: color,
    copper: color,
    copper-dim: color,
    wave: color,
    on-accent: color,
    playing-bg: color,
    accent-text: color,
    hover: color,
    sel-idle: color,
    accent-hover: color,
    chip-hover: color,
    accent-edge: color,
    scrim: color,
    shadow: color,
    mint: color,
    butter: color,
    dots: color,
}

export global P {
    in-out property <int> theme: 0;
    out property <bool> kawaii: theme == 1 || theme == 2;
    // A light palette: dark text on a pale ground.
    out property <bool> light: theme == 1 || theme == 3;
    property <[Palette]> all: [
        // Runout
        { bg: #0e1917, surface: #132220, raised: #172a27, border: #2a3d39, text: #e6ece9, muted: #8fa39d, verdigris: #5fb8a5, verdigris-dim: #2f5f55, copper: #d4884a, copper-dim: #5a3a22, wave: #4a5f5a, on-accent: #0b1513, playing-bg: #5fb8a51f, accent-text: #5fb8a5, hover: #15262399, sel-idle: #15262380, accent-hover: #6fc8b5, chip-hover: #1d332f, accent-edge: transparent, scrim: #050b0acc, shadow: #00000090, mint: #8ed8c3, butter: #ffd27a, dots: #34252f },
        // Kawaii Light
        { bg: #fff8f5, surface: #fff0f2, raised: #ffe6ec, border: #f6cfd9, text: #5a3e47, muted: #a8818d, verdigris: #ff7fa8, verdigris-dim: #ffc2d5, copper: #e0864a, copper-dim: #f6d2b6, wave: #ecc9d3, on-accent: #ffffff, playing-bg: #ffe3ec, accent-text: #e0558a, hover: #ffeef3, sel-idle: #ffeaf0, accent-hover: #ff95b8, chip-hover: #ffeef3, accent-edge: #e4648d, scrim: #5a3e4766, shadow: #b06a8040, mint: #5cc4a8, butter: #ffc95e, dots: #f8d9e2 },
        // Kawaii Dark
        { bg: #241a22, surface: #2d2029, raised: #3b2a36, border: #553d4c, text: #fbe9ef, muted: #c49aab, verdigris: #ff8fb3, verdigris-dim: #7a3f5c, copper: #ffd27a, copper-dim: #6a5530, wave: #6e5262, on-accent: #3a1626, playing-bg: #ff8fb326, accent-text: #ff8fb3, hover: #3b2a3699, sel-idle: #3b2a3680, accent-hover: #ffa6c3, chip-hover: #4a3542, accent-edge: #c25a82, scrim: #120c11cc, shadow: #00000090, mint: #8ed8c3, butter: #ffd27a, dots: #34252f },
        // Light
        { bg: #ffffff, surface: #f5f6f8, raised: #eaedf1, border: #dcdfe5, text: #1d1f23, muted: #686d76, verdigris: #2f6fde, verdigris-dim: #c6d8f7, copper: #b85a17, copper-dim: #f1d6c2, wave: #c3c8d0, on-accent: #ffffff, playing-bg: #2f6fde14, accent-text: #2a62c9, hover: #eff1f4, sel-idle: #f2f4f7, accent-hover: #4580e6, chip-hover: #e8ebef, accent-edge: transparent, scrim: #1d1f2366, shadow: #0000002e, mint: #2f9e7c, butter: #c99a1e, dots: #e6e9ee },
        // Dark
        { bg: #1c1d21, surface: #24262b, raised: #2d3036, border: #3a3d44, text: #e8e9ec, muted: #9a9ea7, verdigris: #5b9cf5, verdigris-dim: #2b4670, copper: #e09a5b, copper-dim: #5a3e26, wave: #4a4e57, on-accent: #0e1420, playing-bg: #5b9cf51f, accent-text: #6aa6f7, hover: #2a2c3199, sel-idle: #2a2c3180, accent-hover: #74adf7, chip-hover: #33363c, accent-edge: transparent, scrim: #000000b3, shadow: #00000090, mint: #5cc4a8, butter: #e5c15a, dots: #2a2c31 },
        // OLED
        { bg: #000000, surface: #000000, raised: #121212, border: #1f1f1f, text: #f2f2f2, muted: #8a8a8a, verdigris: #6aa8ff, verdigris-dim: #1d3354, copper: #f0a868, copper-dim: #3d2a18, wave: #333333, on-accent: #000000, playing-bg: #6aa8ff1a, accent-text: #7ab2ff, hover: #0d0d0d, sel-idle: #0a0a0a, accent-hover: #85b8ff, chip-hover: #1a1a1a, accent-edge: transparent, scrim: #000000d9, shadow: #00000000, mint: #5cc4a8, butter: #e5c15a, dots: #0d0d0d },
    ];
    property <Palette> c: all[theme];

    out property <color> bg: c.bg;
    out property <color> surface: c.surface;
    out property <color> raised: c.raised;
    out property <color> border: c.border;
    out property <color> text: c.text;
    out property <color> muted: c.muted;
    out property <color> verdigris: c.verdigris;
    out property <color> verdigris-dim: c.verdigris-dim;
    out property <color> copper: c.copper;
    out property <color> copper-dim: c.copper-dim;
    out property <color> wave: c.wave;
    out property <color> on-accent: c.on-accent;
    out property <color> playing-bg: c.playing-bg;
    // Text in the accent colour, deeper where the accent is too faint to
    // read on a light ground.
    out property <color> accent-text: c.accent-text;
    // Hover, and a selection while the list doesn't have focus.
    out property <color> hover: c.hover;
    out property <color> sel-idle: c.sel-idle;
    out property <color> accent-hover: c.accent-hover;
    out property <color> chip-hover: c.chip-hover;
    // The pressed-in edge under kawaii buttons.
    out property <color> accent-edge: c.accent-edge;
    out property <color> scrim: c.scrim;
    out property <color> shadow: c.shadow;
    // Kawaii extras: mint and butter, and the dot pattern behind the views.
    out property <color> mint: c.mint;
    out property <color> butter: c.butter;
    out property <color> dots: c.dots;

    out property <string> sans: kawaii ? "Rounded Mplus 1c" : "Inter";
    // Runout's headings are serif; the plain themes keep to Inter.
    out property <string> serif: kawaii ? "Zen Maru Gothic" : theme == 0 ? "Noto Serif" : "Inter";
    out property <string> mono: kawaii ? "Rounded Mplus 1c" : "JetBrains Mono";
    // Corners: kawaii rounds everything off.
    out property <float> round: kawaii ? 2.3 : 1;
}

// ----- Data from Rust -----

export struct SideItem {
    // 0 section, 1 source, 2 label, 3 gap
    kind: int,
    label: string,
    // A second line under the label: the kawaii themes' Japanese names.
    sub: string,
    count: string,
    icon: string,
    active: bool,
    // sources: 0 watching, 1 scanning, 2 missing, 3 idle
    dot: int,
}

export struct Row {
    // 0 track, 1 album, 2 artist, 3 folder, 4 genre, 5 playlist, 6 station,
    // 7 podcast, 8 episode, 9 header, 10 info, 11 missing file, 12 setting,
    // 13 pinned for offline, 14 a download, 15 a button in the list,
    // 16 a saved mix
    kind: int,
    num: string,
    title: string,
    sub: string,
    meta: string,
    right: string,
    playing: bool,
    dim: bool,
    warn: bool,
    selectable: bool,
    art: image,
    has-art: bool,
    downloaded: bool,
    // Settings rows (kind 12): 1 toggle, 2 choice, 3 number, 4 text,
    // 5 library folder, 6 add folder, 7 read-only.
    ctl: int,
    on: bool,
    // Its server can't be reached and none of it is kept here.
    off: bool,
    // Pinned for offline, and whether it could be.
    pinned: bool,
    can-pin: bool,
    // A mix can start from it.
    can-mix: bool,
}

export struct QueueRow {
    title: string,
    sub: string,
    playing: bool,
    failed: bool,
    off: bool,
    art: image,
    has-art: bool,
}

// One EQ band as the EQ panel draws it.
export struct EqBand {
    // Across the graph, 0 to 1 (20 Hz to 20 kHz on a log scale).
    x: float,
    gain: float,
    label: string,
    has-gain: bool,
}

// One knob on a rack unit.
export struct AmpKnob {
    label: string,
    text: string,
    // 0 to 1 around the dial.
    pos: float,
    // The lit part of the dial, as path commands in a 100 x 100 box.
    arc: string,
    // A choice (tape speed, compressor style): click steps it.
    choice: bool,
}

// One unit in the rack.
export struct AmpUnit {
    name: string,
    on: bool,
    knobs: [AmpKnob],
}

export struct Hero {
    show: bool,
    kicker: string,
    title: string,
    sub: string,
    meta: string,
    art: image,
    has-art: bool,
}

// ----- Small parts -----

// Stroke icon from SVG path data on a 24-unit grid.
component Icon inherits Path {
    in property <string> d;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    stroke: P.muted;
    stroke-width: 1.8px;
    fill: transparent;
}

component FilledIcon inherits Path {
    in property <string> d;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    fill: P.muted;
    stroke-width: 0px;
}

